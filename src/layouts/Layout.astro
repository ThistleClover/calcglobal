---
// src/layouts/Layout.astro - Creamy Executive Editorial (Apple / Notion Minimalist)
import { ACTIVE_COUNTRIES } from '../config';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  structuredData?: object | object[];
}

const { 
  title, 
  description, 
  lang = 'en',
  canonical,
  ogImage,
  keywords,
  structuredData
} = Astro.props;

const siteName = 'CalcGlobal';
const siteUrl = Astro.site ? Astro.site.origin : 'https://calcglobal.org';
let rawCanonical = canonical || new URL(Astro.url.pathname, siteUrl).href;
if (!rawCanonical.endsWith('/') && !rawCanonical.match(/\.[a-zA-Z0-9]+$/)) {
  rawCanonical = `${rawCanonical}/`;
}
const pageCanonical = rawCanonical;
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const defaultOgImage = `${siteUrl}/og-image-placeholder.svg`;
const skimlinksId = import.meta.env.PUBLIC_SKIMLINKS_ID || '193792X1669466';

const topCountries = [
  { code: 'us', label: 'USA', flagCode: 'us' },
  { code: 'uk', label: 'UK', flagCode: 'gb' },
  { code: 'fr', label: 'France', flagCode: 'fr' },
  { code: 'de', label: 'Germany', flagCode: 'de' },
  { code: 'ca', label: 'Canada', flagCode: 'ca' },
  { code: 'au', label: 'Australia', flagCode: 'au' },
  { code: 'ch', label: 'Switzerland', flagCode: 'ch' },
  { code: 'ae', label: 'UAE', flagCode: 'ae' },
  { code: 'sg', label: 'Singapore', flagCode: 'sg' },
  { code: 'br', label: 'Brazil', flagCode: 'br' },
];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Production Monetization & Ads (Impact, Skimlinks, AdSense) -->
    {import.meta.env.PROD && (
      <>
        <meta name="impact-site-verification" content="18a3bfa8-eb14-4370-8f22-b3262780db9b" />
        <script type="text/javascript" is:inline>(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7587737-5f1b-4a85-abac-a616e5c99e981.js','script','impactStat',document,window);impactStat('trackImpression');</script>
        <script type="text/javascript" src={`https://s.skimresources.com/js/${skimlinksId}.skimlinks.js`} async is:inline></script>
        <meta name="google-adsense-account" content="ca-pub-6264279528687703" />
        <script async defer src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6264279528687703" crossorigin="anonymous"></script>
      </>
    )}

    <!-- Google Consent Mode v2 Default Settings -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });
    </script>

    <!-- Google Analytics 4 (GA4 Dual Tracking) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5TW23Q86KZ" is:inline></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-5TW23Q86KZ');
      gtag('config', 'G-RQCKV4XLF1');
    </script>

    <!-- Theme Initializer (Defaults strictly to Light Mode unless explicitly switched) -->
    <script is:inline>
      (function() {
        try {
          const storedTheme = localStorage.getItem('calcglobal_theme');
          if (storedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    
    <!-- Primary SEO -->
    <meta name="google-site-verification" content="03WK3K5EsDUB6PL_hkntX6yyCkYwoCd-HaQwAR9Ll-Y" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={pageCanonical} />
    
    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />
    
    <!-- Fonts: Geist, Inter & JetBrains Mono for High-Precision Editorial -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    
    <!-- Phosphor Icons -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css" />

    <!-- Structured Data -->
    {Array.isArray(structuredData) ? (
      structuredData.map(schema => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    ) : structuredData ? (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    ) : null}
    
    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": "Hyper-localized tax, payroll, and statutory calculations for global professionals",
      "publisher": {
        "@type": "Organization",
        "name": "CalcGlobal Tax Advisory & Engineering",
        "url": siteUrl,
        "logo": `${siteUrl}/favicon.svg`,
        "knowsAbout": ["Tax Brackets 2026", "Self-Employment Tax", "PAYE Salary", "URSSAF Cotisations", "Brutto Netto Rechner", "ATO PAYG"],
        "publishingPrinciples": `${siteUrl}/methodology/`
      }
    })} />

    <slot name="head" />
  </head>
  
  <body class="bg-[#F8F6F0] dark:bg-[#0F0E0C] text-[#1C1917] dark:text-[#F5F2EB] font-sans antialiased min-h-screen flex flex-col selection:bg-[#006948] selection:text-white dark:selection:bg-[#6EE7B7] dark:selection:text-[#0F0E0C] transition-colors duration-300">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-white dark:focus:bg-[#1A1816] focus:text-neutral-900 dark:focus:text-white focus:rounded-xl focus:shadow-lg focus:font-semibold focus:text-sm focus:border focus:border-[#E7E2D7] dark:focus:border-[#2A2622]">Skip to content</a>
    
    <!-- Floating Header Container -->
    <header class="sticky top-0 z-50 pt-3 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        
        <!-- Main Floating Pill Navigation -->
        <nav class="bg-[#FDFCF9]/90 dark:bg-[#1A1816]/90 backdrop-blur-md rounded-full border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm px-4 sm:px-6 h-12 flex items-center justify-between gap-4 transition-colors duration-300">
          
          <!-- Brand Logo -->
          <a href={`${base}/`} class="flex items-center gap-2.5 group shrink-0">
            <div class="w-6 h-6 rounded-md bg-[#1C1917] dark:bg-[#F5F2EB] text-[#FDFCF9] dark:text-[#1C1917] flex items-center justify-center font-bold text-[10px] tracking-tight shadow-sm group-hover:scale-105 transition-transform duration-300">
              CG
            </div>
            <span class="font-bold text-sm tracking-tight text-[#1C1917] dark:text-[#F5F2EB]">CalcGlobal</span>
          </a>

          <!-- Desktop Navigation Items -->
          <ul class="hidden md:flex items-center gap-1 text-xs font-medium text-[#78716C] dark:text-[#A8A29E]">
            <li>
              <a href={`${base}/`} class="px-3 py-1.5 rounded-full hover:text-[#1C1917] dark:hover:text-white hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors duration-300">
                Global Index
              </a>
            </li>
            
            <!-- Country Hubs Dropdown Pill -->
            <li class="relative group">
              <button class="px-3 py-1.5 rounded-full hover:text-[#1C1917] dark:hover:text-white hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors duration-300 flex items-center gap-1 cursor-pointer" aria-haspopup="true">
                <span>Jurisdictions</span>
                <i class="ph ph-caret-down text-xs text-[#78716C] dark:text-[#A8A29E] group-hover:rotate-180 transition-transform duration-300"></i>
              </button>
              <div class="absolute top-full left-0 mt-2 w-64 p-2 bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl shadow-xl border border-[#E7E2D7] dark:border-[#2A2622] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 transform origin-top-left scale-95 group-hover:scale-100">
                <div class="grid grid-cols-2 gap-1 text-xs">
                  {topCountries.map((c) => (
                    <a href={`${base}/${c.code}/`} class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] text-[#1C1917] dark:text-[#F5F2EB] transition-colors duration-200">
                      <img
                        src={`https://flagcdn.com/w40/${c.flagCode}.png`}
                        alt={`${c.label} flag`}
                        class="w-4 h-3 object-cover rounded-xs shrink-0 shadow-xs"
                        width="16"
                        height="12"
                        loading="lazy"
                      />
                      <span className="font-medium truncate">{c.label}</span>
                    </a>
                  ))}
                </div>
                <div class="mt-2 pt-2 border-t border-[#E7E2D7] dark:border-[#2A2622]">
                  <a href={`${base}/`} class="block text-center text-[11px] font-semibold text-[#006948] dark:text-[#6EE7B7] py-1 hover:underline transition-colors">
                    View All 15 Countries →
                  </a>
                </div>
              </div>
            </li>

            <li>
              <a href={`${base}/about/`} class="px-3 py-1.5 rounded-full hover:text-[#1C1917] dark:hover:text-white hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors duration-300">
                About
              </a>
            </li>
            <li>
              <a href={`${base}/methodology/`} class="px-3 py-1.5 rounded-full hover:text-[#1C1917] dark:hover:text-white hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors duration-300">
                Methodology
              </a>
            </li>
            <li>
              <a href={`${base}/guides/`} class="px-3 py-1.5 rounded-full text-[#006948] dark:text-[#6EE7B7] hover:bg-[#E7E2D7]/50 dark:hover:bg-[#2A2622] transition-colors duration-300 font-semibold">
                Guides
              </a>
            </li>
            <li>
              <a href={`${base}/contact/`} class="px-3 py-1.5 rounded-full hover:text-[#1C1917] dark:hover:text-white hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors duration-300">
                Contact
              </a>
            </li>
          </ul>

          <!-- Right Controls (Theme Toggle + Mobile Hamburger) -->
          <div class="flex items-center gap-2">
            
            <!-- Theme Switcher Button -->
            <button 
              type="button" 
              id="theme-toggle"
              aria-label="Toggle dark mode"
              class="w-8 h-8 rounded-full bg-[#F0EEE8] dark:bg-[#2A2622] text-[#1C1917] dark:text-[#F5F2EB] flex items-center justify-center hover:scale-105 transition-all duration-300 cursor-pointer"
            >
              <!-- Sun Icon for Dark Mode -->
              <i id="theme-icon-sun" class="ph ph-sun text-amber-400 text-sm hidden dark:block"></i>
              <!-- Moon Icon for Light Mode -->
              <i id="theme-icon-moon" class="ph ph-moon text-[#1C1917] text-sm block dark:hidden"></i>
            </button>

            <!-- Mobile Drawer Hamburger -->
            <button 
              type="button" 
              id="mobile-drawer-button" 
              class="md:hidden w-8 h-8 rounded-full bg-[#F0EEE8] dark:bg-[#2A2622] text-[#1C1917] dark:text-[#F5F2EB] flex items-center justify-center transition-colors duration-300" 
              aria-expanded="false" 
              aria-controls="mobile-drawer"
            >
              <span class="sr-only">Open main menu</span>
              <i class="ph ph-list text-sm"></i>
            </button>
          </div>
        </nav>
      </div>

      <!-- Mobile Slide-over Drawer -->
      <div id="mobile-drawer" class="fixed inset-0 z-50 hidden">
        <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-[#1C1917]/50 dark:bg-[#0F0E0C]/80 backdrop-blur-sm transition-opacity"></div>
        
        <div class="fixed inset-y-0 right-0 max-w-xs w-full bg-[#FDFCF9] dark:bg-[#1A1816] border-l border-[#E7E2D7] dark:border-[#2A2622] p-6 shadow-2xl flex flex-col justify-between overflow-y-auto transform transition-transform duration-300 translate-x-0">
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-[#E7E2D7] dark:border-[#2A2622]">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-md bg-[#1C1917] dark:bg-[#F5F2EB] text-[#FDFCF9] dark:text-[#1C1917] flex items-center justify-center font-bold text-[10px]">
                  CG
                </div>
                <span class="font-bold text-sm text-[#1C1917] dark:text-[#F5F2EB]">CalcGlobal</span>
              </div>
              <button type="button" id="mobile-drawer-close" class="w-8 h-8 rounded-lg text-[#78716C] dark:text-[#A8A29E] hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] hover:text-[#1C1917] dark:hover:text-[#F5F2EB] flex items-center justify-center transition-colors">
                <i class="ph ph-x text-lg"></i>
              </button>
            </div>

            <nav class="mt-6 space-y-1">
              <a href={`${base}/`} class="flex items-center gap-2 px-3 py-2 rounded-xl font-medium text-xs text-[#1C1917] dark:text-[#F5F2EB] hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors">
                <i class="ph ph-globe-hemisphere-west text-sm"></i> Global Calculators Index
              </a>
              <a href={`${base}/about/`} class="flex items-center gap-2 px-3 py-2 rounded-xl font-medium text-xs text-[#1C1917] dark:text-[#F5F2EB] hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors">
                <i class="ph ph-info text-sm"></i> About & CPA Board
              </a>
              <a href={`${base}/methodology/`} class="flex items-center gap-2 px-3 py-2 rounded-xl font-medium text-xs text-[#1C1917] dark:text-[#F5F2EB] hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors">
                <i class="ph ph-clipboard-text text-sm"></i> Audit Methodology & CPA
              </a>
              <a href={`${base}/guides/`} class="flex items-center gap-2 px-3 py-2 rounded-xl font-medium text-xs text-[#006948] dark:text-[#6EE7B7] hover:bg-[#E7E2D7]/40 dark:hover:bg-[#2A2622] transition-colors">
                <i class="ph ph-books text-sm"></i> Tax Guides & Tips
              </a>
              <a href={`${base}/contact/`} class="flex items-center gap-2 px-3 py-2 rounded-xl font-medium text-xs text-[#1C1917] dark:text-[#F5F2EB] hover:bg-[#F0EEE8] dark:hover:bg-[#2A2622] transition-colors">
                <i class="ph ph-envelope-simple text-sm"></i> Contact Team
              </a>
            </nav>

            <div class="mt-6 pt-6 border-t border-[#E7E2D7] dark:border-[#2A2622]">
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#78716C] dark:text-[#A8A29E] mb-3 block">
                Top Jurisdictions
              </span>
              <div class="grid grid-cols-2 gap-2 text-xs">
                {topCountries.map((c) => (
                  <a href={`${base}/${c.code}/`} class="flex items-center gap-2 p-2 rounded-lg bg-[#F0EEE8] dark:bg-[#2A2622] text-[#1C1917] dark:text-[#F5F2EB] font-medium transition-colors hover:bg-[#E7E2D7] dark:hover:bg-[#3E3833]">
                    <img
                      src={`https://flagcdn.com/w40/${c.flagCode}.png`}
                      alt={`${c.label} flag`}
                      class="w-4 h-3 object-cover rounded-xs shrink-0 shadow-xs"
                      width="16"
                      height="12"
                      loading="lazy"
                    />
                    <span>{c.label}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <div class="pt-6 border-t border-[#E7E2D7] dark:border-[#2A2622] text-[11px] text-[#78716C] dark:text-[#A8A29E] flex flex-col gap-1">
            <span>© 2026 CalcGlobal</span>
            <span class="text-[#006948] dark:text-[#6EE7B7] font-medium">Verified for 2026/27 Tax Year</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Institutional Creamy Footer -->
    <footer class="bg-[#FDFCF9] dark:bg-[#1A1816] border-t border-[#E7E2D7] dark:border-[#2A2622] pt-10 pb-12 mt-12 text-xs text-[#78716C] dark:text-[#A8A29E] transition-colors duration-300">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Links Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-[#E7E2D7] dark:border-[#2A2622]">
          <div class="md:col-span-1 fade-up stagger-1">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 rounded-md bg-[#1C1917] dark:bg-[#F5F2EB] text-[#FDFCF9] dark:text-[#1C1917] flex items-center justify-center font-bold text-[10px]">
                CG
              </div>
              <span class="font-bold text-sm text-[#1C1917] dark:text-[#F5F2EB]">CalcGlobal</span>
            </div>
            <p class="leading-relaxed mb-3">
              Precision tax and payroll models for contractors, executives, and remote teams.
            </p>
          </div>

          <div class="fade-up stagger-2">
            <h3 class="font-bold text-[11px] text-[#1C1917] dark:text-[#F5F2EB] uppercase tracking-wider mb-3">
              Top Jurisdictions
            </h3>
            <div class="grid grid-cols-2 gap-y-2 gap-x-3 text-xs">
              <a href={`${base}/us/`} class="flex items-center gap-1.5 hover:text-[#1C1917] dark:hover:text-white transition-colors">
                <img src="https://flagcdn.com/w40/us.png" alt="USA flag" class="w-3.5 h-2.5 object-cover rounded-xs" width="14" height="10" loading="lazy" />
                <span>USA</span>
              </a>
              <a href={`${base}/uk/`} class="flex items-center gap-1.5 hover:text-[#1C1917] dark:hover:text-white transition-colors">
                <img src="https://flagcdn.com/w40/gb.png" alt="UK flag" class="w-3.5 h-2.5 object-cover rounded-xs" width="14" height="10" loading="lazy" />
                <span>UK</span>
              </a>
              <a href={`${base}/fr/`} class="flex items-center gap-1.5 hover:text-[#1C1917] dark:hover:text-white transition-colors">
                <img src="https://flagcdn.com/w40/fr.png" alt="France flag" class="w-3.5 h-2.5 object-cover rounded-xs" width="14" height="10" loading="lazy" />
                <span>France</span>
              </a>
              <a href={`${base}/de/`} class="flex items-center gap-1.5 hover:text-[#1C1917] dark:hover:text-white transition-colors">
                <img src="https://flagcdn.com/w40/de.png" alt="Germany flag" class="w-3.5 h-2.5 object-cover rounded-xs" width="14" height="10" loading="lazy" />
                <span>Germany</span>
              </a>
              <a href={`${base}/br/`} class="flex items-center gap-1.5 hover:text-[#1C1917] dark:hover:text-white transition-colors">
                <img src="https://flagcdn.com/w40/br.png" alt="Brazil flag" class="w-3.5 h-2.5 object-cover rounded-xs" width="14" height="10" loading="lazy" />
                <span>Brazil</span>
              </a>
              <a href={`${base}/ca/`} class="flex items-center gap-1.5 hover:text-[#1C1917] dark:hover:text-white transition-colors">
                <img src="https://flagcdn.com/w40/ca.png" alt="Canada flag" class="w-3.5 h-2.5 object-cover rounded-xs" width="14" height="10" loading="lazy" />
                <span>Canada</span>
              </a>
            </div>
          </div>

          <div class="fade-up stagger-3">
            <h3 class="font-bold text-[11px] text-[#1C1917] dark:text-[#F5F2EB] uppercase tracking-wider mb-3">
              Methodology & Advisory
            </h3>
            <ul class="space-y-1.5 text-xs">
              <li><a href={`${base}/about/`} class="hover:text-[#1C1917] dark:hover:text-white transition-colors">About & CPA Board</a></li>
              <li><a href={`${base}/methodology/`} class="hover:text-[#1C1917] dark:hover:text-white transition-colors">✓ Calculation Audit Standards</a></li>
              <li><a href={`${base}/methodology/#privacy`} class="hover:text-[#1C1917] dark:hover:text-white transition-colors">Zero-Storage Privacy Model</a></li>
              <li><a href={`${base}/guides/`} class="hover:text-[#1C1917] dark:hover:text-white transition-colors">Tax Architecture Guides</a></li>
              <li><a href={`${base}/contact/`} class="hover:text-[#1C1917] dark:hover:text-white transition-colors">Contact Editorial Board</a></li>
            </ul>
          </div>

          <div class="fade-up stagger-3">
            <h3 class="font-bold text-[11px] text-[#1C1917] dark:text-[#F5F2EB] uppercase tracking-wider mb-3">
              Statutory Alerts
            </h3>
            <form id="newsletter-form" class="flex flex-col gap-2">
              <input id="newsletter-email" type="email" placeholder="executive@company.com" class="w-full bg-[#F8F6F0] dark:bg-[#0F0E0C] border border-[#E7E2D7] dark:border-[#2A2622] rounded-xl px-3 py-2 text-xs text-[#1C1917] dark:text-[#F5F2EB] placeholder-[#78716C] dark:placeholder-[#A8A29E] focus:outline-none focus:ring-1 focus:ring-[#006948] dark:focus:ring-[#6EE7B7] transition-colors" required />
              <button type="submit" class="bg-[#006948] text-white font-semibold px-3.5 py-1.5 rounded-xl text-xs hover:bg-[#005137] dark:bg-[#6EE7B7] dark:text-[#0F0E0C] dark:hover:bg-[#4ADE80] transition-colors cursor-pointer">
                Subscribe Updates
              </button>
            </form>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
          <p>© 2026 CalcGlobal. Estimates only. Consult a licensed CPA for formal filings.</p>
          <div class="flex items-center gap-3">
            <a href={`${base}/privacy/`} class="hover:underline">Privacy</a>
            <a href={`${base}/terms/`} class="hover:underline">Terms</a>
            <a href={`${base}/disclaimer/`} class="hover:underline">Disclaimer</a>
          </div>
        </div>
      </div>
    </footer>
    
    <script>
      // Theme Toggle Logic
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('calcglobal_theme', isDark ? 'dark' : 'light');
        });
      }

      // Mobile Drawer Logic
      const drawerBtn = document.getElementById('mobile-drawer-button');
      const drawerClose = document.getElementById('mobile-drawer-close');
      const drawer = document.getElementById('mobile-drawer');
      const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');

      function toggleDrawer(open) {
        if (!drawer) return;
        if (open) {
          drawer.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        } else {
          drawer.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      if (drawerBtn) drawerBtn.addEventListener('click', () => toggleDrawer(true));
      if (drawerClose) drawerClose.addEventListener('click', () => toggleDrawer(false));
      if (drawerBackdrop) drawerBackdrop.addEventListener('click', () => toggleDrawer(false));

      // Newsletter form submission
      const newsletterForm = document.getElementById('newsletter-form');
      const newsletterEmail = document.getElementById('newsletter-email');

      if (newsletterForm && newsletterEmail) {
        newsletterForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = newsletterEmail.value.trim();
          if (email) {
            try {
              const subs = JSON.parse(localStorage.getItem('calcglobal_newsletter_subscribers') || '[]');
              subs.push({ email, subscribedAt: new Date().toISOString() });
              localStorage.setItem('calcglobal_newsletter_subscribers', JSON.stringify(subs));
            } catch (err) {
              console.error('Failed to save to localStorage', err);
            }
            newsletterForm.innerHTML = '<span class="text-[#006948] dark:text-[#6EE7B7] font-medium text-xs">✓ Subscribed to official statutory alerts.</span>';
          }
        });
      }

      // Intersection Observer for scroll animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('.fade-up').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>

<style is:global>
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }

  /* Animations */
  .fade-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .stagger-1 { transition-delay: 100ms; }
  .stagger-2 { transition-delay: 200ms; }
  .stagger-3 { transition-delay: 300ms; }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #F8F6F0;
  }
  html.dark ::-webkit-scrollbar-track {
    background: #0F0E0C;
  }
  ::-webkit-scrollbar-thumb {
    background: #E7E2D7;
    border-radius: 4px;
  }
  html.dark ::-webkit-scrollbar-thumb {
    background: #2A2622;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #78716C;
  }
  html.dark ::-webkit-scrollbar-thumb:hover {
    background: #A8A29E;
  }

  /* No Scrollbar Utility */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
