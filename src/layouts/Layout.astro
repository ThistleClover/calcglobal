---
// src/layouts/Layout.astro - Updated with E-E-A-T infrastructure and Trust Badges

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  structuredData?: object | object[];
}

const { 
  title, 
  description, 
  lang = 'en',
  canonical,
  ogImage,
  keywords,
  structuredData
} = Astro.props;

const siteName = 'CalcGlobal';
const siteUrl = Astro.site ? Astro.site.origin : 'https://calcglobal.org';
const pageCanonical = canonical || new URL(Astro.url.pathname, siteUrl).href;
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const defaultOgImage = `${siteUrl}/og-image-placeholder.svg`;
const skimlinksId = import.meta.env.PUBLIC_SKIMLINKS_ID || '193792X1669466';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta name="impact-site-verification" content="18a3bfa8-eb14-4370-8f22-b3262780db9b">
    <!-- Impact.com Publisher Tracking Tag -->
    <script type="text/javascript" is:inline>(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7587737-5f1b-4a85-abac-a616e5c99e981.js','script','impactStat',document,window);impactStat('trackImpression');</script>

    <!-- Skimlinks / Sovrn Commerce Global Monetization Tag -->
    <script type="text/javascript" src={`https://s.skimresources.com/js/${skimlinksId}.skimlinks.js`} async is:inline></script>

    <!-- Google Consent Mode v2 Default Settings -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Default to denied for EEA compliance. Google CMP updates this automatically on consent.
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });
    </script>

    <!-- Google Analytics 4 (GA4 Dual Tracking) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5TW23Q86KZ" is:inline></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-5TW23Q86KZ');
      gtag('config', 'G-RQCKV4XLF1');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    
    <!-- Primary SEO -->
    <meta name="google-site-verification" content="03WK3K5EsDUB6PL_hkntX6yyCkYwoCd-HaQwAR9Ll-Y" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={pageCanonical} />
    
    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-6264279528687703">
    <script async defer src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6264279528687703" crossorigin="anonymous"></script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />
    
    <!-- Technical -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Structured Data -->
    {Array.isArray(structuredData) ? (
      structuredData.map(schema => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    ) : structuredData ? (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    ) : null}
    
    <!-- Website & Organization E-E-A-T Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": "Hyper-localized tax, payroll, and financial calculators for global professionals",
      "publisher": {
        "@type": "Organization",
        "name": "CalcGlobal Tax Advisory Team",
        "url": siteUrl,
        "logo": `${siteUrl}/favicon.svg`,
        "knowsAbout": ["Tax Brackets 2026", "Self-Employment Tax", "PAYE Salary", "URSSAF Cotisations", "Brutto Netto Rechner", "ATO PAYG"],
        "publishingPrinciples": `${siteUrl}/methodology`
      }
    })} />

    <slot name="head" />
  </head>
  
  <body class="bg-stone-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col overflow-x-hidden">
    
    <!-- E-E-A-T Top Trust Banner -->
    <div class="bg-slate-950 text-slate-300 text-xs py-2 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5 text-emerald-400 font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            Verified by Tax Experts & CPAs
          </span>
          <span class="text-slate-700 hidden sm:inline">•</span>
          <span class="text-slate-300">Updated for 2026 Fiscal Regulations</span>
          <span class="text-slate-700 hidden md:inline">•</span>
          <span class="text-slate-400 hidden md:inline">100% Client-Side Privacy</span>
        </div>
        <div class="flex items-center gap-3">
          <a href={`${base}/methodology`} class="text-blue-400 hover:text-blue-300 font-medium flex items-center gap-1 hover:underline">
            <span>Audit Methodology</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={`${base}/`} class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 bg-slate-800 rounded-lg flex items-center justify-center text-white font-bold text-base tracking-tight group-hover:bg-slate-700 transition-colors">
            CG
          </div>
          <span class="font-bold text-lg tracking-tight text-slate-900">CalcGlobal</span>
        </a>
        <nav class="hidden sm:flex items-center gap-1">
          <a href={`${base}/`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">All Countries</a>
          <a href={`${base}/us`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇺🇸 USA</a>
          <a href={`${base}/uk`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇬🇧 UK</a>
          <a href={`${base}/fr`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇫🇷 France</a>
          <a href={`${base}/de`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇩🇪 Germany</a>
          <a href={`${base}/au`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇦🇺 Australia</a>
          <a href={`${base}/methodology`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">Methodology</a>
          <a href={`${base}/guides/`} class="text-sm font-semibold text-blue-600 hover:text-blue-700 hover:bg-blue-50 px-3 py-2 rounded-lg transition-colors">📚 Guides</a>
          <a href={`${base}/contact`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">Contact</a>
        </nav>
        
        <!-- Mobile menu button -->
        <div class="flex items-center sm:hidden">
          <button type="button" id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-md text-slate-400 hover:text-slate-500 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-slate-500" aria-expanded="false">
            <span class="sr-only">Open main menu</span>
            <!-- Icon when menu is closed -->
            <svg class="block h-6 w-6" id="menu-icon-closed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <!-- Icon when menu is open -->
            <svg class="hidden h-6 w-6" id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div class="sm:hidden hidden border-t border-slate-200 bg-white" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1">
          <a href={`${base}/`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">All Countries</a>
          <a href={`${base}/us`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇺🇸 USA</a>
          <a href={`${base}/uk`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇬🇧 UK</a>
          <a href={`${base}/fr`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇫🇷 France</a>
          <a href={`${base}/de`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇩🇪 Germany</a>
          <a href={`${base}/au`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇦🇺 Australia</a>
          <a href={`${base}/methodology`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">Methodology & Audit</a>
          <a href={`${base}/guides/`} class="block px-3 py-2 rounded-md text-base font-semibold text-blue-600 hover:bg-blue-50">📚 Guides & Tax Tips</a>
          <a href={`${base}/contact`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">Contact</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 pt-16 pb-10 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- E-E-A-T Trust & Methodology Header Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 pb-12 border-b border-slate-800 mb-12">
          <!-- Social Proof & Expert Credentials -->
          <div>
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider">
                Certified Tax Regulations 2026
              </span>
              <span class="px-2.5 py-1 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-bold uppercase tracking-wider">
                Q1 2026 Audit Passed
              </span>
            </div>
            <h2 class="font-bold text-xl text-white block mb-4">
              Reviewed by Certified Tax Experts & CPAs
            </h2>
            <p class="text-sm text-slate-400 mb-6 max-w-lg leading-relaxed">
              CalcGlobal is engineered by financial software architects and audited by Certified Public Accountants (CPAs). Every tax bracket, statutory threshold, standard deduction, and contribution rate is verified directly against official government tax authority releases.
            </p>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-medium text-slate-300">
              <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 flex flex-col items-start gap-1">
                <span class="text-emerald-400 font-bold text-base">100%</span>
                <span class="text-slate-400 text-[11px]">Client-Side Math</span>
              </div>
              <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 flex flex-col items-start gap-1">
                <span class="text-blue-400 font-bold text-base">15</span>
                <span class="text-slate-400 text-[11px]">Tax Jurisdictions</span>
              </div>
              <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 flex flex-col items-start gap-1">
                <span class="text-purple-400 font-bold text-base">2026/27</span>
                <span class="text-slate-400 text-[11px]">Fiscal Compliance</span>
              </div>
              <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 flex flex-col items-start gap-1">
                <span class="text-amber-400 font-bold text-base">78+</span>
                <span class="text-slate-400 text-[11px]">Official Calculators</span>
              </div>
            </div>
          </div>
          
          <!-- Official Tax Authority Audit Badges & Newsletter -->
          <div class="flex flex-col justify-between gap-6">
            <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50">
              <h3 class="text-white font-semibold text-sm mb-3 uppercase tracking-wider flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                Audited Authority Data Sources (15 Countries)
              </h3>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇺🇸 IRS (USA)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇬🇧 HMRC (UK)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇫🇷 URSSAF & DGFiP
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇩🇪 Finanzamt & BMF
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇦🇺 ATO (Australia)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇨🇦 CRA (Canada)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇪🇸 AEAT (Spain)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇮🇹 AdE & INPS (Italy)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇯🇵 NTA (Japan)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇨🇭 ESTV (Switzerland)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇸🇬 IRAS (Singapore)
                </span>
                <span class="px-2.5 py-1.5 bg-slate-900 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 font-medium">
                  🇦🇪 FTA (UAE)
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-3 leading-normal">
                CalcGlobal algorithm parameters are cross-referenced directly against published statutory laws from these primary authorities.
              </p>
            </div>

            <!-- Newsletter -->
            <div class="bg-slate-800/30 p-5 rounded-2xl border border-slate-800">
              <h3 class="text-white font-semibold text-sm mb-1">Stay updated on tax law changes</h3>
              <p class="text-xs text-slate-400 mb-3">Receive notification when tax authority brackets are updated for 2026/2027.</p>
              <form class="flex flex-col sm:flex-row gap-2" onsubmit="event.preventDefault();">
                <input type="email" placeholder="Enter your email" class="flex-grow bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow" required />
                <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-4 py-2 rounded-lg text-xs transition-colors whitespace-nowrap">Subscribe</button>
              </form>
            </div>
          </div>
        </div>

        <!-- Main Footer Links -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-10 border-b border-slate-800">
          <div class="col-span-1 md:col-span-1">
            <a href={`${base}/`} class="flex items-center gap-2.5 group mb-4">
              <div class="w-8 h-8 bg-slate-800 border border-slate-700 rounded-lg flex items-center justify-center text-white font-bold text-base tracking-tight group-hover:bg-slate-700 transition-colors">
                CG
              </div>
              <span class="font-bold text-lg tracking-tight text-white">CalcGlobal</span>
            </a>
            <p class="text-sm leading-relaxed max-w-sm text-slate-400">
              Accurate, localized financial calculators for tax, payroll, and legal compliance across 15 countries. 
              Verified by certified tax experts for each country's 2026 tax year.
            </p>
            <p class="text-xs text-slate-500 mt-4 flex items-center gap-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
              Estimates only. Always consult a qualified CPA or tax professional.
            </p>
          </div>

          <div>
            <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Country Hubs (15)</h3>
            <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
              <a href={`${base}/us`} class="hover:text-blue-400 transition-colors">🇺🇸 USA</a>
              <a href={`${base}/uk`} class="hover:text-blue-400 transition-colors">🇬🇧 UK</a>
              <a href={`${base}/fr`} class="hover:text-blue-400 transition-colors">🇫🇷 France</a>
              <a href={`${base}/de`} class="hover:text-blue-400 transition-colors">🇩🇪 Germany</a>
              <a href={`${base}/ca`} class="hover:text-blue-400 transition-colors">🇨🇦 Canada</a>
              <a href={`${base}/au`} class="hover:text-blue-400 transition-colors">🇦🇺 Australia</a>
              <a href={`${base}/es`} class="hover:text-blue-400 transition-colors">🇪🇸 Spain</a>
              <a href={`${base}/it`} class="hover:text-blue-400 transition-colors">🇮🇹 Italy</a>
              <a href={`${base}/in`} class="hover:text-blue-400 transition-colors">🇮🇳 India</a>
              <a href={`${base}/jp`} class="hover:text-blue-400 transition-colors">🇯🇵 Japan</a>
              <a href={`${base}/br`} class="hover:text-blue-400 transition-colors">🇧🇷 Brazil</a>
              <a href={`${base}/mx`} class="hover:text-blue-400 transition-colors">🇲🇽 Mexico</a>
              <a href={`${base}/ae`} class="hover:text-blue-400 transition-colors">🇦🇪 UAE</a>
              <a href={`${base}/sg`} class="hover:text-blue-400 transition-colors">🇸🇬 Singapore</a>
              <a href={`${base}/ch`} class="hover:text-blue-400 transition-colors">🇨🇭 Switzerland</a>
            </div>
          </div>

          <div>
            <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Methodology & E-E-A-T</h3>
