---
// src/layouts/Layout.astro - Updated with proper SEO infrastructure

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object | object[];
}

const { 
  title, 
  description, 
  lang = 'en',
  canonical,
  ogImage,
  structuredData
} = Astro.props;

const siteName = 'CalcGlobal';
const siteUrl = Astro.site ? Astro.site.origin : 'https://calcglobal.org';
const pageCanonical = canonical || new URL(Astro.url.pathname, siteUrl).href;
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const defaultOgImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta name="impact-site-verification" value="18a3bfa8-eb14-4370-8f22-b3262780db9b">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageCanonical} />
    
    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-6264279528687703">
    <script async defer src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6264279528687703" crossorigin="anonymous"></script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />
    
    <!-- Technical -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Structured Data -->
    {Array.isArray(structuredData) ? (
      structuredData.map(schema => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    ) : structuredData ? (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    ) : null}
    
    <!-- Website Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": "Hyper-localized tax, payroll, and financial calculators for global professionals"
    })} />

    <slot name="head" />
  </head>
  
  <body class="bg-stone-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    
    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={`${base}/`} class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 bg-slate-800 rounded-lg flex items-center justify-center text-white font-bold text-base tracking-tight group-hover:bg-slate-700 transition-colors">
            CG
          </div>
          <span class="font-bold text-lg tracking-tight text-slate-900">CalcGlobal</span>
        </a>
        <nav class="hidden sm:flex items-center gap-1">
          <a href={`${base}/`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">All Countries</a>
          <a href={`${base}/us`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇺🇸 USA</a>
          <a href={`${base}/uk`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇬🇧 UK</a>
          <a href={`${base}/fr`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇫🇷 France</a>
          <a href={`${base}/de`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇩🇪 Germany</a>
          <a href={`${base}/au`} class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 px-3 py-2 rounded-lg transition-colors">🇦🇺 Australia</a>
        </nav>
        
        <!-- Mobile menu button -->
        <div class="flex items-center sm:hidden">
          <button type="button" id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-md text-slate-400 hover:text-slate-500 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-slate-500" aria-expanded="false">
            <span class="sr-only">Open main menu</span>
            <!-- Icon when menu is closed -->
            <svg class="block h-6 w-6" id="menu-icon-closed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <!-- Icon when menu is open -->
            <svg class="hidden h-6 w-6" id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div class="sm:hidden hidden border-t border-slate-200 bg-white" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1">
          <a href={`${base}/`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">All Countries</a>
          <a href={`${base}/us`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇺🇸 USA</a>
          <a href={`${base}/uk`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇬🇧 UK</a>
          <a href={`${base}/fr`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇫🇷 France</a>
          <a href={`${base}/de`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇩🇪 Germany</a>
          <a href={`${base}/au`} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-50">🇦🇺 Australia</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 pt-16 pb-10 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Social Proof & Newsletter Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 pb-12 border-b border-slate-800 mb-12">
          <!-- Social Proof -->
          <div>
            <span class="font-bold text-xl text-white block mb-4">Trusted globally</span>
            <p class="text-sm text-slate-400 mb-6 max-w-md">
              Over 1 million professionals trust CalcGlobal every month for accurate tax, payroll, and compliance calculations.
            </p>
            <div class="flex items-center gap-4">
              <div class="flex -space-x-2">
                <div class="w-8 h-8 rounded-full bg-slate-700 border-2 border-slate-900"></div>
                <div class="w-8 h-8 rounded-full bg-slate-600 border-2 border-slate-900"></div>
                <div class="w-8 h-8 rounded-full bg-slate-500 border-2 border-slate-900"></div>
                <div class="w-8 h-8 rounded-full bg-slate-400 border-2 border-slate-900 flex items-center justify-center text-xs text-white font-medium">+2k</div>
              </div>
              <div class="flex text-amber-400">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              </div>
            </div>
          </div>
          
          <!-- Newsletter -->
          <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50">
            <h3 class="text-white font-semibold mb-2">Stay updated on tax law changes</h3>
            <p class="text-sm text-slate-400 mb-4">Get notified when rates change for the 2026 tax year.</p>
            <form class="flex flex-col sm:flex-row gap-2" onsubmit="event.preventDefault();">
              <input type="email" placeholder="Enter your email" class="flex-grow bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow" required />
              <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-5 py-2.5 rounded-lg text-sm transition-colors whitespace-nowrap">Subscribe</button>
            </form>
          </div>
        </div>

        <!-- Main Footer Links -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-10 border-b border-slate-800">
          <div class="col-span-1 md:col-span-2">
            <a href={`${base}/`} class="flex items-center gap-2.5 group mb-4">
              <div class="w-8 h-8 bg-slate-800 border border-slate-700 rounded-lg flex items-center justify-center text-white font-bold text-base tracking-tight group-hover:bg-slate-700 transition-colors">
                CG
              </div>
              <span class="font-bold text-lg tracking-tight text-white">CalcGlobal</span>
            </a>
            <p class="text-sm leading-relaxed max-w-sm">
              Accurate, localized financial calculators for tax, payroll, and legal compliance. 
              Built by professionals, verified for each country's 2026 tax year.
            </p>
            <p class="text-xs text-slate-500 mt-4 flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
              Estimates only. Always consult a qualified tax professional.
            </p>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Calculators</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href={`${base}/us`} class="hover:text-blue-400 transition-colors">🇺🇸 United States</a></li>
              <li><a href={`${base}/uk`} class="hover:text-blue-400 transition-colors">🇬🇧 United Kingdom</a></li>
              <li><a href={`${base}/fr`} class="hover:text-blue-400 transition-colors">🇫🇷 France</a></li>
              <li><a href={`${base}/de`} class="hover:text-blue-400 transition-colors">🇩🇪 Germany</a></li>
              <li><a href={`${base}/au`} class="hover:text-blue-400 transition-colors">🇦🇺 Australia</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Legal</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href={`${base}/privacy`} class="hover:text-blue-400 transition-colors">Privacy Policy</a></li>
              <li><a href={`${base}/terms`} class="hover:text-blue-400 transition-colors">Terms of Service</a></li>
              <li><a href={`${base}/disclaimer`} class="hover:text-blue-400 transition-colors">Tax Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-500">© 2026 CalcGlobal. All rights reserved.</p>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <p class="text-xs text-slate-400">Tax rates updated for the 2026/2027 fiscal year</p>
          </div>
        </div>
      </div>
    </footer>
    
    <script>
      // Mobile menu toggle logic
      const btn = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      const iconClosed = document.getElementById('menu-icon-closed');
      const iconOpen = document.getElementById('menu-icon-open');

      if (btn && menu && iconClosed && iconOpen) {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true' || false;
          btn.setAttribute('aria-expanded', !expanded);
          menu.classList.toggle('hidden');
          iconClosed.classList.toggle('hidden');
          iconClosed.classList.toggle('block');
          iconOpen.classList.toggle('hidden');
          iconOpen.classList.toggle('block');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  * { box-sizing: border-box; }
  
  /* Smooth number input appearance */
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button { opacity: 1; }
</style>
