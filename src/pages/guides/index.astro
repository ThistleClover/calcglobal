---
// src/pages/guides/index.astro - Creamy Executive Editorial
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');

// Sort by pubDate descending
const sortedGuides = allGuides.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const countryNames: Record<string, { name: string; flag: string }> = {
  fr: { name: 'France', flag: 'fr' },
  us: { name: 'United States', flag: 'us' },
  uk: { name: 'United Kingdom', flag: 'gb' },
  de: { name: 'Germany', flag: 'de' },
  au: { name: 'Australia', flag: 'au' },
  global: { name: 'Global', flag: 'un' },
};

const uniqueCountries = [...new Set(sortedGuides.map(g => g.data.country))].sort();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcglobal.org/" },
    { "@type": "ListItem", "position": 2, "name": "Guides & Tax Tips", "item": "https://calcglobal.org/guides/" }
  ]
};

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Tax, Business & Legal Guides 2026 | CalcGlobal",
  "description": "Expert financial, payroll, and tax compliance guides for freelancers, business owners, and employees worldwide.",
  "url": "https://calcglobal.org/guides/"
};
---

<Layout
  title="Tax, Business & Payroll Guides 2026 | CalcGlobal"
  description="Comprehensive editorial guides on tax compliance, business bank accounts, ACRE exonerations, IR35 rules, and self-employment taxes. Written by financial specialists."
  structuredData={[breadcrumbSchema, collectionPageSchema]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    
    <!-- Editorial Breadcrumb -->
    <nav class="text-xs text-[#78716C] dark:text-[#A8A29E] mb-6 flex items-center gap-2 font-medium">
      <a href={`${base}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Home</a>
      <span class="text-[#E7E2D7]">/</span>
      <span class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold">Tax & Business Guides</span>
    </nav>
    
    <!-- Hero Header -->
    <div class="p-6 sm:p-8 rounded-2xl bg-[#FDFCF9] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient mb-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#006948]/10 text-[#006948] dark:text-[#6EE7B7] border border-[#006948]/20 text-[10px] font-semibold mb-2">
          <i class="ph-fill ph-check-circle"></i>
          Editorial & Compliance Analysis
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight leading-tight mb-2">
          Tax Architecture & Advisory Guides
        </h1>
        <p class="text-xs sm:text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
          In-depth technical guides, statutory filing strategies, and legal compliance breakdowns audited by our certified CPA team.
        </p>
      </div>
    </div>

    <!-- Country Filter Pills -->
    <div class="flex items-center gap-1.5 mb-8 overflow-x-auto pb-2 no-scrollbar">
      <button 
        class="filter-pill active px-3 py-1.5 rounded-full text-xs font-semibold bg-[#1C1917] text-white dark:bg-[#F5F2EB] dark:text-[#1C1917] transition-all cursor-pointer"
        data-country="all"
      >
        All Jurisdictions ({sortedGuides.length})
      </button>
      {uniqueCountries.map(c => {
        const info = countryNames[c] || { name: c.toUpperCase(), flag: c };
        const count = sortedGuides.filter(g => g.data.country === c).length;
        return (
          <button 
            class="filter-pill px-3 py-1.5 rounded-full text-xs font-medium bg-[#FDFCF9] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] text-[#78716C] dark:text-[#A8A29E] hover:text-[#1C1917] dark:hover:text-white transition-all cursor-pointer"
            data-country={c}
          >
            {info.name} ({count})
          </button>
        );
      })}
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="guides-grid">
      {sortedGuides.map((guide) => {
        const cInfo = countryNames[guide.data.country] || { name: guide.data.country.toUpperCase(), flag: guide.data.country };
        const guideSlug = (guide as any).slug || guide.id.replace(/\.md$/, '');
        return (
          <article 
            class="guide-card group bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-5 border border-[#E7E2D7] dark:border-[#2A2622] hover:border-[#78716C] dark:hover:border-[#A8A29E] shadow-ambient hover:shadow-ambient-hover transition-all duration-200 flex flex-col justify-between"
            data-country={guide.data.country}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-[#F0EEE8] dark:bg-[#252220] text-[10px] font-mono font-medium text-[#1C1917] dark:text-[#F5F2EB]">
                  {cInfo.name}
                </span>
                <span class="text-[10px] text-[#78716C] font-mono">
                  {guide.data.readTime || '5 min read'}
                </span>
              </div>

              <h2 class="text-sm font-bold text-[#1C1917] dark:text-[#F5F2EB] group-hover:text-[#006948] dark:group-hover:text-[#6EE7B7] transition-colors leading-snug mb-2">
                <a href={`${base}/guides/${guideSlug}/`} class="focus:outline-none">
                  {guide.data.title}
                </a>
              </h2>

              <p class="text-xs text-[#78716C] dark:text-[#A8A29E] line-clamp-3 leading-relaxed mb-4">
                {guide.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[#E7E2D7]/70 dark:border-[#2A2622]/70 flex items-center justify-between text-xs font-semibold text-[#1C1917] dark:text-[#F5F2EB]">
              <span class="text-[11px] text-[#78716C] font-normal">By {guide.data.author || 'CPA Editorial Board'}</span>
              <a href={`${base}/guides/${guideSlug}/`} class="text-[#006948] dark:text-[#6EE7B7] flex items-center gap-1">
                Read Guide <i class="ph ph-arrow-right group-hover:translate-x-0.5 transition-transform"></i>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.guide-card');

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const country = pill.dataset.country;

        pills.forEach(p => {
          p.classList.remove('bg-[#1C1917]', 'text-white', 'dark:bg-[#F5F2EB]', 'dark:text-[#1C1917]');
          p.classList.add('bg-[#FDFCF9]', 'dark:bg-[#1A1816]', 'text-[#78716C]', 'dark:text-[#A8A29E]');
        });
        pill.classList.remove('bg-[#FDFCF9]', 'dark:bg-[#1A1816]', 'text-[#78716C]', 'dark:text-[#A8A29E]');
        pill.classList.add('bg-[#1C1917]', 'text-white', 'dark:bg-[#F5F2EB]', 'dark:text-[#1C1917]');

        cards.forEach(card => {
          if (country === 'all' || card.dataset.country === country) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
