---
// src/pages/guides/[...slug].astro - Creamy Executive Editorial
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => {
    const slug = (entry as any).slug || entry.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = (entry as any).slug || entry.id.replace(/\.md$/, '');
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const countryNames: Record<string, { name: string; flag: string }> = {
  fr: { name: 'France', flag: 'fr' },
  us: { name: 'United States', flag: 'us' },
  uk: { name: 'United Kingdom', flag: 'gb' },
  de: { name: 'Germany', flag: 'de' },
  au: { name: 'Australia', flag: 'au' },
  global: { name: 'Global', flag: 'un' },
};

const countryInfo = countryNames[entry.data.country] || { name: entry.data.country.toUpperCase(), flag: 'un' };

// Article & Breadcrumb Schema for E-E-A-T
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": entry.data.title,
  "description": entry.data.description,
  "inLanguage": entry.data.country === 'fr' ? 'fr-FR' : 'en-US',
  "datePublished": entry.data.pubDate.toISOString(),
  "dateModified": (entry.data.updatedDate || entry.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": entry.data.author,
    "jobTitle": entry.data.authorRole
  },
  "publisher": {
    "@type": "Organization",
    "name": "CalcGlobal",
    "url": "https://calcglobal.org"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://calcglobal.org/guides/${slug}/`
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcglobal.org/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://calcglobal.org/guides/" },
    { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": `https://calcglobal.org/guides/${slug}/` }
  ]
};

const formattedPubDate = entry.data.pubDate.toLocaleDateString(entry.data.country === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

const formattedUpdatedDate = entry.data.updatedDate ? entry.data.updatedDate.toLocaleDateString(entry.data.country === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}) : null;
---

<Layout
  title={`${entry.data.title} | CalcGlobal`}
  description={entry.data.description}
  lang={entry.data.country === 'fr' ? 'fr' : 'en'}
  structuredData={[breadcrumbSchema, articleSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    
    <!-- Editorial Breadcrumb -->
    <nav class="text-xs text-[#78716C] dark:text-[#A8A29E] mb-6 flex items-center gap-2 font-medium flex-wrap">
      <a href={`${base}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Home</a>
      <span class="text-[#E7E2D7]">/</span>
      <a href={`${base}/guides/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Guides</a>
      <span class="text-[#E7E2D7]">/</span>
      <span class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold truncate max-w-xs">{entry.data.title}</span>
    </nav>

    <!-- Header Block -->
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <a
          href={`${base}/${entry.data.country}/`}
          class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-[#F0EEE8] dark:bg-[#252220] text-[#1C1917] dark:text-[#F5F2EB] text-xs font-semibold rounded-lg border border-[#E7E2D7] dark:border-[#2A2622]"
        >
          <img
            src={`https://flagcdn.com/w20/${countryInfo.flag}.png`}
            alt={`${countryInfo.name} flag`}
            class="w-3.5 h-2.5 object-cover rounded-xs"
            width="20"
            height="15"
            loading="lazy"
          />
          {countryInfo.name} Calculators
        </a>
        
        <span class="inline-block px-2.5 py-0.5 bg-[#006948]/10 text-[#006948] dark:text-[#6EE7B7] border border-[#006948]/20 text-[10px] font-semibold rounded-md uppercase tracking-wider">
          {entry.data.category}
        </span>
        
        <span class="flex items-center gap-1 text-xs font-mono text-[#78716C] dark:text-[#A8A29E]">
          <i class="ph ph-clock"></i> {entry.data.readTime || '5 min'} read
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight leading-tight mb-3">
        {entry.data.title}
      </h1>

      <p class="text-[#78716C] dark:text-[#A8A29E] text-xs sm:text-sm leading-relaxed mb-5 border-l-2 border-[#006948] dark:border-[#6EE7B7] pl-3 py-0.5">
        {entry.data.description}
      </p>

      <!-- Author Card -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#E7E2D7] dark:border-[#2A2622] text-xs text-[#78716C] dark:text-[#A8A29E]">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-[#1C1917] dark:bg-[#F5F2EB] text-white dark:text-[#1C1917] flex items-center justify-center font-bold text-xs">
            {entry.data.author.charAt(0)}
          </div>
          <div>
            <div class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold">{entry.data.author}</div>
            <div class="text-[10px] text-[#78716C]">{entry.data.authorRole}</div>
          </div>
        </div>

        <div class="flex items-center gap-3 text-[11px]">
          <span>Published: <strong class="text-[#1C1917] dark:text-[#F5F2EB] font-medium">{formattedPubDate}</strong></span>
          {formattedUpdatedDate && (
            <span class="text-[#006948] dark:text-[#6EE7B7] font-medium">Updated: {formattedUpdatedDate}</span>
          )}
        </div>
      </div>
    </div>

    <!-- Tags -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 mb-6">
        {entry.data.tags.map((tag) => (
          <span class="px-2 py-0.5 bg-[#F0EEE8] dark:bg-[#252220] text-[#1C1917] dark:text-[#F5F2EB] text-[10px] font-mono rounded-md border border-[#E7E2D7] dark:border-[#2A2622]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Markdown Content Container -->
    <main class="guide-content bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622] p-6 sm:p-8 shadow-ambient mb-10 text-xs sm:text-sm leading-relaxed text-[#1C1917] dark:text-[#F5F2EB]">
      <Content />
    </main>

    <!-- Related Calculators Callout Box -->
    {entry.data.relatedCalculators && entry.data.relatedCalculators.length > 0 && (
      <div class="p-6 rounded-2xl bg-[#FDFCF9] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient mb-8">
        <div class="flex items-center gap-2.5 mb-3">
          <i class="ph ph-calculator text-xl text-[#006948] dark:text-[#6EE7B7]"></i>
          <div>
            <h3 class="text-xs font-bold text-[#1C1917] dark:text-[#F5F2EB]">
              Related Statutory Calculators
            </h3>
            <p class="text-[11px] text-[#78716C]">Run simulations with verified 2026 mathematical models</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {entry.data.relatedCalculators.map((calcId: string) => (
            <a
              href={`${base}/${entry.data.country}/${calcId}/`}
              class="flex items-center justify-between p-3 rounded-xl bg-[#F8F6F0] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622] hover:border-[#78716C] dark:hover:border-[#A8A29E] text-xs font-semibold text-[#1C1917] dark:text-[#F5F2EB] transition-colors"
            >
              <span class="truncate">{calcId.replace(/-/g, ' ')}</span>
              <i class="ph ph-arrow-right text-[#006948] dark:text-[#6EE7B7] ml-2"></i>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Legal Compliance Disclaimer -->
    <div class="p-3.5 rounded-xl bg-[#F0EEE8] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] text-[11px] text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
      <strong>Disclaimer:</strong> This guide provides general educational information regarding statutory tax laws and compliance in {countryInfo.name}. It does not constitute formal legal, accounting, or tax advisory services. Always consult a certified CPA or tax lawyer for specific situations.
    </div>
  </div>
</Layout>

<style is:global>
  .guide-content h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--tw-prose-headings, inherit);
  }
  .guide-content h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .guide-content p {
    margin-bottom: 1rem;
    line-height: 1.65;
  }
  .guide-content ul, .guide-content ol {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
  }
  .guide-content li {
    margin-bottom: 0.35rem;
  }
  .guide-content strong {
    font-weight: 700;
  }
  .guide-content blockquote {
    border-left: 3px solid #006948;
    padding-left: 1rem;
    font-style: italic;
    margin: 1.25rem 0;
    color: #78716C;
  }
  .guide-content table {
    width: 100%;
    margin: 1.25rem 0;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  .guide-content th, .guide-content td {
    padding: 0.5rem 0.75rem;
    border: 1px solid #E7E2D7;
  }
  .guide-content th {
    background-color: #F0EEE8;
    font-weight: 700;
    text-align: left;
  }
  
  .dark .guide-content blockquote {
    border-left-color: #6EE7B7;
    color: #A8A29E;
  }
  .dark .guide-content th, .dark .guide-content td {
    border-color: #2A2622;
  }
  .dark .guide-content th {
    background-color: #252220;
    color: #F5F2EB;
  }
</style>
