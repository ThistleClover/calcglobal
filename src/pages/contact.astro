---
// src/pages/contact.astro - Creamy Executive Editorial
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const FORMSPREE_ENDPOINT = "https://formspree.io/f/xkgwrjlp";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact CalcGlobal Editorial Board",
  "description": "Get in touch with the CalcGlobal CPA editorial board and engineering team for statutory inquiries, corrections, or partnerships.",
  "url": "https://calcglobal.org/contact/"
};
---

<Layout 
  title="Contact Advisory & Engineering | CalcGlobal" 
  description="Contact the CalcGlobal CPA advisory team and financial software architects. Fast response on statutory inquiries and partnership requests."
  structuredData={contactSchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    
    <!-- Editorial Breadcrumb -->
    <nav class="text-xs text-[#78716C] dark:text-[#A8A29E] mb-6 flex items-center gap-2 font-medium">
      <a href={`${base}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Home</a>
      <span class="text-[#E7E2D7]">/</span>
      <span class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold">Contact Editorial Board</span>
    </nav>
    
    <!-- Hero Header -->
    <div class="p-6 sm:p-8 rounded-2xl bg-[#FDFCF9] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient mb-10">
      <div class="max-w-2xl">
        <span class="text-[10px] font-mono text-[#006948] dark:text-[#6EE7B7] uppercase tracking-wider block mb-1">
          Statutory Communications
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight leading-tight mb-2">
          Get in Touch with our Editorial Team
        </h1>
        <p class="text-xs text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
          Questions regarding statutory tax calculations, bug reports, or business partnership inquiries? Our team typically responds within 24 business hours.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Left Column: Info Cards -->
      <div class="lg:col-span-5 space-y-4">
        
        <div class="bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-5 border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient">
          <div class="flex items-center gap-2.5 mb-2">
            <i class="ph ph-envelope text-xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <h3 class="text-xs font-bold text-[#1C1917] dark:text-[#F5F2EB]">Direct Email Inquiries</h3>
          </div>
          <p class="text-[11px] text-[#78716C] dark:text-[#A8A29E] mb-2">CPA review submissions and technical inquiries.</p>
          <a href="mailto:contact@calcglobal.org" class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7] hover:underline">
            contact@calcglobal.org →
          </a>
        </div>

        <div class="bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-5 border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient">
          <div class="flex items-center gap-2.5 mb-2">
            <i class="ph ph-lock text-xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <h3 class="text-xs font-bold text-[#1C1917] dark:text-[#F5F2EB]">Zero-Data Privacy</h3>
          </div>
          <p class="text-[11px] text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
            All simulation data is computed 100% locally in your browser. We never capture, save, or transmit your financial records.
          </p>
        </div>

        <div class="bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-5 border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient">
          <div class="flex items-center gap-2.5 mb-2">
            <i class="ph ph-lightning text-xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <h3 class="text-xs font-bold text-[#1C1917] dark:text-[#F5F2EB]">Fast SLA</h3>
          </div>
          <p class="text-[11px] text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
            Partnership and editorial queries are reviewed within 24 business hours by our lead analysts.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7 bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622] p-6 sm:p-8 shadow-ambient">
        <h2 class="text-base font-bold text-[#1C1917] dark:text-[#F5F2EB] mb-1">
          Send a Message
        </h2>
        <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mb-5">
          Fill out the form below and our team will get back to you promptly.
        </p>

        <form id="contact-form" action={FORMSPREE_ENDPOINT} method="POST" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-[11px] font-semibold text-[#78716C] dark:text-[#A8A29E] mb-1">
                Your Name *
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="Alex Morgan" 
                class="w-full bg-[#F8F6F0] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622] rounded-xl px-3.5 py-2.5 text-xs text-[#1C1917] dark:text-[#F5F2EB] focus:outline-none focus:ring-1 focus:ring-[#006948]"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-[11px] font-semibold text-[#78716C] dark:text-[#A8A29E] mb-1">
                Email Address *
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="alex@company.com" 
                class="w-full bg-[#F8F6F0] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622] rounded-xl px-3.5 py-2.5 text-xs text-[#1C1917] dark:text-[#F5F2EB] focus:outline-none focus:ring-1 focus:ring-[#006948]"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-[11px] font-semibold text-[#78716C] dark:text-[#A8A29E] mb-1">
              Subject *
            </label>
            <select 
              id="contact-subject" 
              name="subject" 
              required
              class="w-full bg-[#F8F6F0] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622] rounded-xl px-3.5 py-2.5 text-xs text-[#1C1917] dark:text-[#F5F2EB] focus:outline-none focus:ring-1 focus:ring-[#006948] cursor-pointer"
            >
              <option value="Calculation Feedback / Bug Report">Calculation Feedback / Bug Report</option>
              <option value="Statutory Rate Update Inquiry">Statutory Rate Update Inquiry</option>
              <option value="Partnership & Integration">Partnership & Integration</option>
              <option value="CPA Advisory Collaboration">CPA Advisory Collaboration</option>
              <option value="Other">Other Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-[11px] font-semibold text-[#78716C] dark:text-[#A8A29E] mb-1">
              Message *
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="4" 
              required 
              placeholder="How can we assist you?" 
              class="w-full bg-[#F8F6F0] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622] rounded-xl p-3.5 text-xs text-[#1C1917] dark:text-[#F5F2EB] focus:outline-none focus:ring-1 focus:ring-[#006948]"
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="contact-submit"
            class="w-full bg-[#006948] dark:bg-[#6EE7B7] hover:bg-[#005137] dark:hover:bg-[#5CD6A6] text-white dark:text-[#1C1917] font-semibold py-3 px-6 rounded-xl text-xs transition-colors shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>Send Message</span>
            <i class="ph ph-arrow-right"></i>
          </button>

          <p id="contact-status" class="hidden text-xs text-center font-medium p-3 rounded-xl"></p>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit');

    if (form && status && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = 'Sending...';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });

          if (res.ok) {
            form.reset();
            status.className = 'text-xs text-center font-medium p-3 rounded-xl bg-emerald-50 dark:bg-[#1A1816] text-emerald-700 dark:text-[#6EE7B7] border border-emerald-200 dark:border-[#2A2622]';
            status.textContent = '✓ Message sent successfully! Our editorial team will review your inquiry shortly.';
            status.classList.remove('hidden');
          } else {
            throw new Error();
          }
        } catch (err) {
          status.className = 'text-xs text-center font-medium p-3 rounded-xl bg-red-50 dark:bg-[#1A1816] text-red-700 dark:text-red-400 border border-red-200 dark:border-[#2A2622]';
          status.textContent = '✕ Error submitting form. Please email contact@calcglobal.org directly.';
          status.classList.remove('hidden');
        } finally {
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = '<span>Send Message</span> <i class="ph ph-arrow-right"></i>';
        }
      });
    }
  </script>
</Layout>
