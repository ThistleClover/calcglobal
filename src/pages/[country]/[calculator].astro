---
// src/pages/[country]/[calculator].astro - Creamy Executive Editorial
import Layout from '../../layouts/Layout.astro';
import InteractiveCalculator from '../../components/InteractiveCalculator';
import CpaLeadCapture from '../../components/CpaLeadCapture.astro';
import fs from 'fs';
import path from 'path';
import { ACTIVE_COUNTRIES, COUNTRY_METADATA } from '../../config';
import { getEngineKeyForCalc } from '../../lib/engine/factory';
import { getTranslatedCategory, getUITranslation } from '../../utils/translations';
import { getAffiliatePartners } from '../../utils/affiliateMatching';
import { getCalculatorFaqs } from '../../utils/faq';

export function getStaticPaths() {
  const dbDir = path.join(process.cwd(), 'database', 'countries');
  const files = fs.readdirSync(dbDir).filter(f => f.endsWith('.json'));
  const paths: any[] = [];

  files.forEach(file => {
    const raw = fs.readFileSync(path.join(dbDir, file), 'utf-8');
    const data = JSON.parse(raw);
    const slug = data.country_code.toLowerCase();
    if (!ACTIVE_COUNTRIES.includes(slug as any)) return;

    data.calculators.forEach((calc: any) => {
      paths.push({
        params: { country: slug, calculator: calc.id },
        props: { countryData: data, calcData: calc },
      });
    });
  });

  return paths;
}

const { countryData, calcData } = Astro.props;
const slug = countryData.country_code.toLowerCase();
const meta = COUNTRY_METADATA[slug] || { lang: 'en', locale: 'en-US', currencySymbol: '$' };
const engineKey = getEngineKeyForCalc(calcData.id) ?? slug;

// Filter affiliate partners using strict brand matching rules
const matchedAffiliates = getAffiliatePartners({
  calcId: calcData.id,
  countryCode: slug,
  category: calcData.category,
  title: calcData.title_en || calcData.title_native,
  description: calcData.description_native,
  affiliateTargets: calcData.affiliate_targets,
  lang: meta.lang,
});

const updatedCalcData = {
  ...calcData,
  affiliate_targets: matchedAffiliates,
};

const isHighIntentCalc = calcData.category === 'tax' || calcData.category === 'business' || [
  's-corp', 'llc', 'capital-gains', 'self-employment', '1099', 'corporate', 'ir35', 'sole-trader', 'gmbh', 'dividend', 'vat', 'payroll', 'tax'
].some(kw => calcData.id.toLowerCase().includes(kw));
const flagCode = slug === 'uk' ? 'gb' : slug;

// SEO Structured Data
const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": calcData.title_en || calcData.title_native,
  "url": `https://calcglobal.org/${slug}/${calcData.id}/`,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "softwareVersion": "2026.1",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": countryData.currency || "USD" },
  "description": calcData.description_native,
  "author": {
    "@type": "Organization",
    "name": "CalcGlobal",
    "url": "https://calcglobal.org"
  },
  "provider": {
    "@type": "Organization",
    "name": "CalcGlobal",
    "url": "https://calcglobal.org"
  }
};

const allFaqs = getCalculatorFaqs(calcData, countryData, meta.lang);

const faqSchema = allFaqs && allFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcglobal.org/" },
    { "@type": "ListItem", "position": 2, "name": countryData.country, "item": `https://calcglobal.org/${slug}/` },
    { "@type": "ListItem", "position": 3, "name": calcData.title_en || calcData.title_native, "item": `https://calcglobal.org/${slug}/${calcData.id}/` }
  ]
};

const explanationSentences = calcData.formula_explanation 
  ? calcData.formula_explanation.split(/(?<=\.)\s+/).filter(Boolean)
  : [];

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<Layout
  title={`${calcData.title_en || calcData.title_native} | ${countryData.country} | CalcGlobal`}
  description={calcData.description_native}
  lang={meta.lang}
  structuredData={[breadcrumbSchema, calcSchema, faqSchema].filter(Boolean)}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    
    <!-- Editorial Breadcrumb -->
    <nav class="text-xs text-[#78716C] dark:text-[#A8A29E] mb-6 flex items-center gap-2 font-medium overflow-x-auto no-scrollbar">
      <a href={`${base}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Home</a>
      <span class="text-[#E7E2D7]">/</span>
      <a href={`${base}/${slug}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors flex items-center gap-1.5">
        <img src={`https://flagcdn.com/w20/${flagCode}.png`} alt="" class="w-3.5 h-2.5 object-cover rounded-xs inline" />
        <span>{countryData.country}</span>
      </a>
      <span class="text-[#E7E2D7]">/</span>
      <span class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold truncate">{calcData.title_native}</span>
    </nav>

    <!-- Header Block -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="px-2 py-0.5 rounded-md bg-[#F0EEE8] dark:bg-[#252220] text-[#1C1917] dark:text-[#F5F2EB] text-[10px] font-semibold uppercase tracking-wider border border-[#E7E2D7] dark:border-[#2A2622]">
          {getTranslatedCategory(calcData.category, meta.lang)}
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#006948]/10 text-[#006948] dark:text-[#6EE7B7] border border-[#006948]/20 text-[10px] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-[#006948] dark:bg-[#6EE7B7]"></span>
          2026/27 Verified
        </span>
        {meta.authorityAbbr && (
          <span class="text-[11px] font-mono text-[#78716C] dark:text-[#A8A29E]">
            {meta.authorityAbbr} Compliant
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight leading-tight">
        {calcData.title_en || calcData.title_native}
      </h1>
      <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-1 max-w-2xl leading-relaxed">
        {calcData.description_native}
      </p>
    </div>

    <!-- The Interactive Calculator Component -->
    <div class="mb-10">
      <InteractiveCalculator
        client:load
        calc={updatedCalcData}
        locale={meta.locale}
        currencySymbol={meta.currencySymbol}
        countryCode={engineKey}
      />
    </div>

    <!-- High Intent CPA Lead Capture -->
    {isHighIntentCalc && (
      <div class="mb-10">
        <CpaLeadCapture
          variant="card"
          title={`Consult a Verified ${countryData.country} Tax Specialist`}
          subtitle={`Save taxes and structure your filings properly for ${calcData.title_en || calcData.title_native}.`}
          location={countryData.country}
          calculatorId={calcData.id}
        />
      </div>
    )}

    <!-- Statutory Methodology Explanations -->
    {calcData.formula_explanation && (
      <section class="p-6 sm:p-8 rounded-2xl bg-[#FDFCF9] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient mb-10">
        <div class="flex items-center justify-between border-b border-[#E7E2D7] dark:border-[#2A2622] pb-3 mb-4">
          <div class="flex items-center gap-2">
            <i class="ph ph-file-text text-xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <h2 class="text-sm font-bold text-[#1C1917] dark:text-[#F5F2EB]">
              {meta.lang === 'fr' ? 'Méthodologie de calcul & Formules Légales' : 'Calculation Methodology & Statutory Rules'}
            </h2>
          </div>
          <a href={`${base}/methodology/`} class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7] hover:underline">
            Audit Details →
          </a>
        </div>

        <div class="space-y-2 text-xs text-[#78716C] dark:text-[#A8A29E]">
          {explanationSentences.map((sentence: string) => (
            <div class="flex items-start gap-2.5 p-3 rounded-xl bg-[#F8F6F0] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622]">
              <i class="ph-fill ph-check-circle text-[#006948] dark:text-[#6EE7B7] mt-0.5"></i>
              <p class="leading-relaxed">{sentence}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ Section (Collapsible Accordion UI) -->
    {allFaqs && allFaqs.length > 0 && (
      <section class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <i class="ph ph-question text-xl text-[#006948] dark:text-[#6EE7B7]"></i>
          <h2 class="text-base font-bold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight">
            {getUITranslation('FAQ_TITLE', meta.lang)}
          </h2>
        </div>

        <div class="space-y-2.5">
          {allFaqs.map((faq: any, index: number) => (
            <details
              class="group rounded-xl bg-[#FDFCF9] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] shadow-ambient overflow-hidden transition-all duration-200"
              open={index === 0}
            >
              <summary class="flex items-center justify-between p-4 cursor-pointer font-bold text-xs sm:text-sm text-[#1C1917] dark:text-[#F5F2EB] select-none hover:bg-[#F8F6F0] dark:hover:bg-[#252220]/50 transition-colors list-none">
                <span class="flex items-start gap-2.5 pr-4">
                  <span class="text-[#006948] dark:text-[#6EE7B7] font-mono font-bold text-xs mt-0.5">Q{index + 1}.</span>
                  <span class="leading-snug">{faq.question}</span>
                </span>
                <span class="shrink-0 w-6 h-6 rounded-lg bg-[#F0EEE8] dark:bg-[#252220] flex items-center justify-center text-[#78716C] dark:text-[#A8A29E] group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </span>
              </summary>
              <div class="px-4 pb-4 pt-1 text-xs text-[#78716C] dark:text-[#A8A29E] leading-relaxed border-t border-[#E7E2D7]/60 dark:border-[#2A2622]/60 mt-1">
                <p class="pl-6 pt-2">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Disclaimer Bar -->
    <div class="p-3.5 rounded-xl bg-[#F0EEE8] dark:bg-[#1A1816] border border-[#E7E2D7] dark:border-[#2A2622] text-[11px] text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
      <p set:html={getUITranslation('DISCLAIMER_TEXT', meta.lang).replace(/^([^:]+[::：])/, '<strong>$1</strong>')} />
    </div>
  </div>
</Layout>
