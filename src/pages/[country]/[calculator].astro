---
import Layout from '../../layouts/Layout.astro';
import InteractiveCalculator from '../../components/InteractiveCalculator';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';
import fs from 'fs';
import path from 'path';
import { ACTIVE_COUNTRIES, COUNTRY_METADATA } from '../../config';
import { getEngineKeyForCalc } from '../../lib/engine/factory';
import { getTranslatedCategory, getUITranslation } from '../../utils/translations';

export function getStaticPaths() {
  const dbDir = path.join(process.cwd(), 'database', 'countries');
  const files = fs.readdirSync(dbDir).filter(f => f.endsWith('.json'));
  const paths: any[] = [];

  files.forEach(file => {
    const raw = fs.readFileSync(path.join(dbDir, file), 'utf-8');
    const data = JSON.parse(raw);
    const slug = data.country_code.toLowerCase();
    if (!ACTIVE_COUNTRIES.includes(slug as any)) return;

    data.calculators.forEach((calc: any) => {
      paths.push({
        params: { country: slug, calculator: calc.id },
        props: { countryData: data, calcData: calc },
      });
    });
  });

  return paths;
}

const { countryData, calcData } = Astro.props;
const slug = countryData.country_code.toLowerCase();
const meta = COUNTRY_METADATA[slug] || { lang: 'en', locale: 'en-US', currencySymbol: '$' };
const engineKey = getEngineKeyForCalc(calcData.id) ?? slug;

// Serialize the real engine function at build time so it can be evaluated client-side
// This avoids dynamic import() with template literals which breaks Vite's bundler
let engineCode = 'return { grossIncome: 0, netIncome: 0, totalTax: 0, effectiveRate: 0, breakdown: [], currency: "USD", currencySymbol: "$" };';
try {
  const engineModule = await import(`../../lib/engine/countries/${engineKey}.ts`);
  // Serialize the calculate function body to a string that new Function('inputs', code) can execute
  const fnStr = engineModule.calculate.toString();
  // Extract function body (everything between first { and last })
  const bodyStart = fnStr.indexOf('{') + 1;
  const bodyEnd = fnStr.lastIndexOf('}');
  engineCode = fnStr.substring(bodyStart, bodyEnd);
} catch (e) {
  console.warn(`[CalcGlobal] No engine for ${engineKey}, using fallback`);
}

const flagCode = slug === 'uk' ? 'gb' : slug;

// SEO Structured Data
const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": calcData.title_en || calcData.title_native,
  "url": `https://calcglobal.org/${slug}/${calcData.id}/`,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "softwareVersion": "2026.1",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": countryData.currency || "USD" },
  "description": calcData.description_native,
  "author": {
    "@type": "Organization",
    "name": "CalcGlobal",
    "url": "https://calcglobal.org"
  },
  "provider": {
    "@type": "Organization",
    "name": "CalcGlobal",
    "url": "https://calcglobal.org"
  }
};

const faqSchema = calcData.article_faq && calcData.article_faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": calcData.article_faq.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcglobal.org/" },
    { "@type": "ListItem", "position": 2, "name": countryData.country, "item": `https://calcglobal.org/${slug}/` },
    { "@type": "ListItem", "position": 3, "name": calcData.title_en || calcData.title_native, "item": `https://calcglobal.org/${slug}/${calcData.id}/` }
  ]
};

const explanationSentences = calcData.formula_explanation 
  ? calcData.formula_explanation.split(/(?<=\.)\s+/).filter(Boolean)
  : [];

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<Layout
  title={`${calcData.title_en || calcData.title_native} | ${countryData.country} | CalcGlobal`}
  description={calcData.description_native}
  lang={meta.lang}
  structuredData={[breadcrumbSchema, calcSchema, faqSchema].filter(Boolean)}
>
  <!-- Page Header -->
  <div class="bg-slate-800 text-white pt-12 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="text-slate-400 text-sm mb-6 flex items-center gap-2 flex-wrap">
        <a href={`${base}/`} class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href={`${base}/${slug}`} class="hover:text-white transition-colors flex items-center gap-1.5">
          <img src={`https://flagcdn.com/w20/${flagCode}.png`} alt="" class="w-4 h-3 object-cover rounded-sm" />
          {countryData.country}
        </a>
        <span>/</span>
        <span class="text-slate-300 truncate">{calcData.title_native}</span>
      </nav>

      <!-- Title & Authority Metadata Row -->
      <div class="flex items-center gap-2.5 flex-wrap mb-3">
        <span class="inline-block px-2.5 py-1 bg-slate-700 text-slate-300 text-xs font-semibold rounded-md tracking-wide border border-slate-600">
          {getTranslatedCategory(calcData.category, meta.lang)}
        </span>
        {meta.authorityAbbr && (
          <span class="inline-block px-2.5 py-1 bg-blue-950/80 text-blue-300 text-xs font-semibold rounded-md border border-blue-800/80">
            🏛️ {meta.authorityAbbr} Compliance
          </span>
        )}
        {calcData.last_updated && (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-950/80 text-emerald-300 text-xs font-semibold rounded-md border border-emerald-800/80">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Updated {calcData.last_updated}
          </span>
        )}
      </div>

      <h1 class="text-2xl md:text-3xl lg:text-4xl font-extrabold tracking-tight leading-tight">
        {calcData.title_en || calcData.title_native}
      </h1>
      <p class="text-slate-400 mt-3 max-w-3xl text-sm md:text-base leading-relaxed">
        {calcData.description_native}
      </p>
    </div>
  </div>

  <!-- Calculator & Content Area -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 -mt-10">

    <!-- The Interactive Calculator (React Island) -->
    <InteractiveCalculator
      client:load
      calc={calcData}
      engineCode={engineCode}
      locale={meta.locale}
      currencySymbol={meta.currencySymbol}
    />

    <!-- Strategic AdSlot 1 -->
    <AdSlot variant="rectangle" className="my-10" />

    <!-- About & Calculation Methodology (Task 3 & E-E-A-T) -->
    {calcData.formula_explanation && (
      <section class="mt-12 bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6 flex-wrap gap-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg">
              🧮
            </div>
            <div>
              <h2 class="text-xl font-bold text-slate-900">
                {meta.lang === 'fr' ? 'À propos de ce calculateur & Méthodologie' : meta.lang === 'de' ? 'Über diesen Rechner & Berechnungsmethodik' : 'About this Calculator & Calculation Methodology'}
              </h2>
              <p class="text-xs text-slate-500">
                Sourced from official {meta.taxAuthority || 'statutory'} regulations
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-3 py-1 bg-slate-100 text-slate-700 rounded-full border border-slate-200">
              2026/27 Tax Year
            </span>
            {calcData.last_updated && (
              <span class="text-xs font-semibold px-3 py-1 bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Updated {calcData.last_updated}
              </span>
            )}
          </div>
        </div>

        <div class="space-y-3.5">
          {explanationSentences.map((sentence: string) => (
            <div class="flex items-start gap-3 bg-slate-50/80 p-3.5 rounded-xl border border-slate-100">
              <span class="text-emerald-600 font-bold text-sm mt-0.5 select-none">✓</span>
              <p class="text-slate-700 text-sm leading-relaxed font-normal">{sentence}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 pt-6 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Official Authority: <strong class="text-slate-700">{meta.authorityAbbr || countryData.country}</strong></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Reviewed by Financial Analysts</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>2026 Statutory Rates</span>
          </div>
        </div>
      </section>
    )}

    <!-- Affiliate Partners (Prominent Recommended Tools Section) -->
    {calcData.affiliate_targets && calcData.affiliate_targets.length > 0 && (
      <section class="mt-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-slate-900">{getUITranslation('RECOMMENDED_TOOLS', meta.lang)}</h2>
          <span class="text-xs text-slate-400 font-medium">Verified Partners</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {calcData.affiliate_targets.slice(0, 3).map((partner: any) => (
            <AffiliateCard partner={partner} />
          ))}
        </div>
      </section>
    )}

    <!-- Strategic AdSlot 2 -->
    <AdSlot variant="in-article" className="my-12" />

    <!-- FAQ / Article Content (Task 1 FAQ Schema matching) -->
    {calcData.article_faq && calcData.article_faq.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-slate-900 mb-6">{getUITranslation('FAQ_TITLE', meta.lang)}</h2>
        <div class="space-y-6">
          {calcData.article_faq.map((faq: any) => (
            <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
              <h3 class="font-bold text-slate-900 text-base mb-3">{faq.question}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Legal Disclaimer -->
    <div class="mt-12 bg-amber-50 border border-amber-200 rounded-xl px-6 py-5">
      <p class="text-xs text-amber-800 leading-relaxed" set:html={getUITranslation('DISCLAIMER_TEXT', meta.lang).replace('Disclaimer:', '<strong>Disclaimer:</strong>').replace('Avertissement :', '<strong>Avertissement :</strong>').replace('Haftungsausschluss:', '<strong>Haftungsausschluss:</strong>')} />
    </div>
  </div>
</Layout>

