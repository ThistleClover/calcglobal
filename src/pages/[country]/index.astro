---
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { ACTIVE_COUNTRIES, COUNTRY_METADATA } from '../../config';
import { getTranslatedCategory } from '../../utils/translations';

export function getStaticPaths() {
  const dbDir = path.join(process.cwd(), 'database', 'countries');
  const files = fs.readdirSync(dbDir).filter(f => f.endsWith('.json'));

  return files
    .map(file => {
      const raw = fs.readFileSync(path.join(dbDir, file), 'utf-8');
      const data = JSON.parse(raw);
      const slug = data.country_code.toLowerCase();
      if (!ACTIVE_COUNTRIES.includes(slug as any)) return null;
      return { params: { country: slug }, props: { data } };
    })
    .filter(Boolean);
}

const { data } = Astro.props;
const slug = data.country_code.toLowerCase();
const meta = COUNTRY_METADATA[slug] || { 
  lang: 'en', 
  locale: 'en-US', 
  currencySymbol: '$',
  title: `${data.country} Tax Calculators 2026 | CalcGlobal`,
  h1: `${data.country} Financial Calculators`,
  description: `Free, accurate ${data.country} tax, payroll and financial calculators updated for the 2026 tax year.`,
  taxAuthority: 'National Tax Authority',
  authorityAbbr: 'Tax Authority',
  intro: `Accurate ${data.country} tax and financial calculators based on official statutory rates.`,
  features: ['Statutory 2026 Tax Brackets', 'Verified Formulas']
};

const flagCode = slug === 'uk' ? 'gb' : slug;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcglobal.org/" },
    { "@type": "ListItem", "position": 2, "name": data.country, "item": `https://calcglobal.org/${slug}/` }
  ]
};

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={meta.lang}
  structuredData={breadcrumbSchema}
>
  <!-- Premium Hero -->
  <div class="relative bg-slate-900 pt-16 pb-28 px-4 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-900/20 via-slate-900 to-slate-900"></div>
    <div class="max-w-6xl mx-auto relative z-10">
      <nav class="text-slate-400 text-sm mb-10 flex items-center gap-2 font-medium">
        <a href={`${base}/`} class="hover:text-white transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <span class="text-white bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700 shadow-sm">{data.country}</span>
      </nav>
      
      <div class="flex items-start md:items-center gap-6 flex-col md:flex-row">
        <div class="w-20 h-14 rounded-xl shadow-lg overflow-hidden border-2 border-white/10 shrink-0">
          <img
            src={`https://flagcdn.com/w160/${flagCode}.png`}
            alt={`${data.country} flag`}
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-300 mb-3 break-words">{meta.h1}</h1>
          <div class="flex flex-wrap items-center gap-3 text-slate-300 text-sm md:text-base font-medium">
            <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> 2026/27 Tax Year</span>
            <span class="text-slate-600 hidden sm:inline">•</span>
            <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg> Verified with {meta.taxAuthority}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 -mt-16 relative z-20">
    
    <!-- Calculators Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {data.calculators.map((calc: any) => (
        <a
          href={`${base}/${slug}/${calc.id}`}
          class="group bg-white rounded-2xl border border-slate-200/80 p-1 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col hover:border-blue-500/30"
        >
          <div class="bg-slate-50/50 rounded-xl p-6 h-full flex flex-col group-hover:bg-blue-50/30 transition-colors border border-transparent">
            <div class="flex items-start justify-between mb-5">
              <span class="inline-block px-3 py-1 bg-white text-slate-700 border border-slate-200 shadow-sm text-xs font-bold rounded-lg tracking-wide uppercase group-hover:border-blue-200 group-hover:text-blue-700 transition-colors">
                {getTranslatedCategory(calc.category, meta.lang)}
              </span>
              <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center shadow-sm border border-slate-200 group-hover:bg-blue-600 group-hover:border-blue-600 group-hover:text-white text-slate-400 transition-all">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </div>
            </div>
            <h2 class="text-lg font-bold text-slate-900 group-hover:text-blue-800 transition-colors mb-3 leading-snug">
              {calc.title_native}
            </h2>
            <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed mb-6">
              {calc.description_native}
            </p>
            
            <div class="mt-auto pt-4 border-t border-slate-200/60 flex items-center justify-between text-xs font-semibold">
              <div class="flex items-center gap-1.5 text-slate-400">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Updated {calc.last_updated || '2026'}
              </div>
              <span class="text-blue-600 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">Open Calculator</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Country E-E-A-T & Authority Section -->
    <section class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm relative overflow-hidden">
      <div class="absolute right-0 top-0 w-64 h-64 bg-slate-50 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 opacity-70"></div>
      
      <div class="relative z-10 flex items-center gap-4 border-b border-slate-100 pb-6 mb-6">
        <div class="w-12 h-12 rounded-xl bg-slate-800 text-white flex items-center justify-center font-bold text-xl shadow-inner">
          🏛️
        </div>
        <div>
          <h2 class="text-2xl font-bold text-slate-900">{data.country} Tax Regulatory Framework</h2>
          <p class="text-sm text-slate-500 font-medium">Official standards & calculation parameters</p>
        </div>
      </div>

      <p class="text-slate-600 leading-relaxed mb-8 max-w-3xl relative z-10">
        {meta.intro} Our system continuously monitors the {meta.taxAuthority} for updates to ensure calculations reflect the most current legislation.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 relative z-10">
        {meta.features.map((feature: string) => (
          <div class="flex items-center gap-3 bg-slate-50 p-4 rounded-xl border border-slate-100 shadow-sm text-sm font-medium text-slate-700 hover:border-slate-200 transition-colors">
            <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span>{feature}</span>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm font-medium text-slate-500 relative z-10 bg-slate-50 rounded-xl p-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          Primary Body: <strong class="text-slate-900">{meta.taxAuthority}</strong>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          Fiscal Period: <strong class="text-slate-900">2026 / 2027</strong>
        </div>
      </div>
    </section>

  </div>
</Layout>

