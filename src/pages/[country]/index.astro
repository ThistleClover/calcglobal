---
// src/pages/[country]/index.astro - Creamy Executive Editorial
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { ACTIVE_COUNTRIES, COUNTRY_METADATA } from '../../config';
import { getTranslatedCategory } from '../../utils/translations';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  const dbDir = path.join(process.cwd(), 'database', 'countries');
  const files = fs.readdirSync(dbDir).filter(f => f.endsWith('.json'));

  return files
    .map(file => {
      const raw = fs.readFileSync(path.join(dbDir, file), 'utf-8');
      const data = JSON.parse(raw);
      const slug = data.country_code.toLowerCase();
      if (!ACTIVE_COUNTRIES.includes(slug as any)) return null;
      return { params: { country: slug }, props: { data } };
    })
    .filter(Boolean);
}

const { data } = Astro.props;
const slug = data.country_code.toLowerCase();
const meta = COUNTRY_METADATA[slug] || { 
  lang: 'en', 
  locale: 'en-US', 
  currencySymbol: '$',
  title: `${data.country} Tax Calculators 2026 | CalcGlobal`,
  h1: `${data.country} Financial Calculators`,
  description: `Free, accurate ${data.country} tax, payroll and financial calculators updated for the 2026 tax year.`,
  taxAuthority: 'National Tax Authority',
  authorityAbbr: 'Tax Authority',
  intro: `Accurate ${data.country} tax and financial calculators based on official statutory rates.`,
  features: ['Statutory 2026 Tax Brackets', 'Verified Formulas']
};

const allGuides = await getCollection('guides');
const countryGuides = allGuides.filter(g => g.data.country === slug);

const flagCode = slug === 'uk' ? 'gb' : slug;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcglobal.org/" },
    { "@type": "ListItem", "position": 2, "name": data.country, "item": `https://calcglobal.org/${slug}/` }
  ]
};

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={meta.lang}
  structuredData={breadcrumbSchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    
    <!-- Editorial Breadcrumb -->
    <nav class="text-xs text-[#78716C] dark:text-[#A8A29E] mb-6 flex items-center gap-2 font-medium">
      <a href={`${base}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Home</a>
      <span class="text-[#E7E2D7]">/</span>
      <span class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold">{data.country} Calculators</span>
    </nav>
    
    <!-- Country Header Banner -->
    <div class="p-6 sm:p-8 rounded-2xl bg-[#FDFCF9] dark:bg-[#1C1916] border border-[#E7E2D7] dark:border-[#2C2724] shadow-ambient mb-10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <div class="w-14 h-10 rounded-md overflow-hidden border border-[#E7E2D7] dark:border-[#2C2724] shadow-xs shrink-0">
          <img
            src={`https://flagcdn.com/w160/${flagCode}.png`}
            alt={`${data.country} flag`}
            class="w-full h-full object-cover"
            width="80"
            height="55"
            loading="lazy"
          />
        </div>
        
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#006948]/10 text-[#006948] dark:text-[#85f8c4] border border-[#006948]/20 text-[10px] font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#006948] dark:bg-[#85f8c4]"></span>
              2026/27 Tax Year Active
            </span>
            <span class="text-[#E7E2D7]">•</span>
            <span class="text-xs font-mono text-[#78716C] dark:text-[#A8A29E]">
              {meta.taxAuthority}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight">
            {meta.h1}
          </h1>
          <p class="text-xs text-[#78716C] dark:text-[#A8A29E] mt-1 max-w-2xl leading-relaxed">
            {meta.description}
          </p>
        </div>
      </div>
    </div>

    <!-- Calculators Grid -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-base font-bold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight">
          Available Statutory Engines ({data.calculators.length})
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {data.calculators.map((calc: any) => (
          <a
            href={`${base}/${slug}/${calc.id}/`}
            class="group bg-[#FDFCF9] dark:bg-[#1C1916] rounded-2xl p-5 border border-[#E7E2D7] dark:border-[#2C2724] hover:border-[#78716C] dark:hover:border-[#A8A29E] shadow-ambient hover:shadow-ambient-hover transition-all duration-200 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="px-2 py-0.5 rounded-md bg-[#F0EEE8] dark:bg-[#2C2724] text-[#1C1917] dark:text-[#F5F2EB] text-[10px] font-semibold uppercase tracking-wide">
                  {getTranslatedCategory(calc.category, meta.lang)}
                </span>
                <span class="text-[10px] font-mono text-[#78716C]">
                  v2026.1
                </span>
              </div>

              <h3 class="text-sm font-bold text-[#1C1917] dark:text-[#F5F2EB] group-hover:text-[#006948] dark:group-hover:text-[#85f8c4] transition-colors mb-1.5 leading-snug">
                {calc.title_native}
              </h3>
              <p class="text-xs text-[#78716C] line-clamp-2 leading-relaxed mb-4">
                {calc.description_native}
              </p>
            </div>

            <div class="pt-2.5 border-t border-[#E7E2D7]/70 dark:border-[#2C2724]/70 flex items-center justify-between text-xs font-semibold text-[#1C1917] dark:text-[#F5F2EB]">
              <span>View Calculator</span>
              <span class="group-hover:translate-x-0.5 transition-transform text-[#006948] dark:text-[#85f8c4]"><i class="ph ph-arrow-right"></i></span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- US Programmatic Section -->
    {slug === 'us' && (
      <div class="mb-14 p-6 sm:p-8 rounded-2xl bg-[#1C1917] text-[#FDFCF9] dark:bg-[#1C1916] border border-[#2C2724]">
        <div class="max-w-2xl mb-5">
          <span class="text-[10px] font-mono text-[#85f8c4] uppercase tracking-wider block mb-1">
            Programmatic State Infrastructure
          </span>
          <h2 class="text-lg font-bold tracking-tight">
            State & Profession Self-Employment Calculators
          </h2>
          <p class="text-xs text-[#A8A29E] mt-0.5 leading-relaxed">
            Targeted Schedule C calculations customized by US state tax codes.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
          {[
            { code: 'ca', name: 'California' },
            { code: 'ny', name: 'New York' },
            { code: 'tx', name: 'Texas' },
            { code: 'fl', name: 'Florida' },
            { code: 'il', name: 'Illinois' },
          ].map((st) => (
            <div class="p-3 rounded-xl bg-[#252220] border border-[#2A2622] flex flex-col justify-between">
              <span class="text-xs font-bold text-[#F5F2EB] mb-2">{st.name} ({st.code.toUpperCase()})</span>
              <div class="space-y-1 text-xs">
                <a href={`${base}/us/${st.code}-freelance-developer-tax-calculator/`} class="flex items-center gap-1.5 p-1.5 rounded-lg bg-[#1A1816] hover:bg-[#2A2622] text-[#A8A29E] hover:text-[#F5F2EB] transition-colors">
                  <i class="ph ph-laptop"></i> Dev Tax
                </a>
                <a href={`${base}/us/${st.code}-consultant-tax-calculator/`} class="flex items-center gap-1.5 p-1.5 rounded-lg bg-[#1A1816] hover:bg-[#2A2622] text-[#A8A29E] hover:text-[#F5F2EB] transition-colors">
                  <i class="ph ph-briefcase"></i> Consultant Tax
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Dedicated Country Guides -->
    {countryGuides.length > 0 && (
      <div class="mb-14">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-base font-bold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight">
            {slug === 'fr' ? 'Guides Fiscaux 2026' : `${data.country} Tax & Compliance Guides`}
          </h2>
          <a href={`${base}/guides/`} class="text-xs font-semibold text-[#006948] dark:text-[#85f8c4] hover:underline">
            All Guides →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {countryGuides.map((guide) => {
            const guideSlug = (guide as any).slug || guide.id.replace(/\.md$/, '');
            return (
              <a href={`${base}/guides/${guideSlug}/`} class="p-4 rounded-xl bg-[#FDFCF9] dark:bg-[#1C1916] border border-[#E7E2D7] dark:border-[#2C2724] hover:border-[#78716C] shadow-ambient transition-all block">
                <div class="flex items-center justify-between text-[11px] text-[#78716C] mb-1.5">
                  <span class="font-mono">{guide.data.category}</span>
                  <span>{guide.data.readTime || '5 min'}</span>
                </div>
                <h3 class="text-xs font-bold text-[#1C1917] dark:text-[#F5F2EB] mb-1">
                  {guide.data.title}
                </h3>
                <p class="text-[11px] text-[#78716C] line-clamp-2 leading-relaxed">
                  {guide.data.description}
                </p>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <!-- Statutory Authority Framework Card -->
    <div class="p-6 rounded-2xl bg-[#FDFCF9] dark:bg-[#1C1916] border border-[#E7E2D7] dark:border-[#2C2724] shadow-ambient">
      <div class="flex items-center gap-2.5 mb-3">
        <i class="ph ph-buildings text-xl text-[#006948] dark:text-[#85f8c4]"></i>
        <div>
          <h2 class="text-sm font-bold text-[#1C1917] dark:text-[#F5F2EB]">
            {data.country} Statutory Regulatory Framework
          </h2>
          <p class="text-[11px] text-[#78716C]">Official Standards & Mathematical Models</p>
        </div>
      </div>
      <p class="text-xs text-[#78716C] dark:text-[#A8A29E] leading-relaxed mb-4 max-w-3xl">
        {meta.intro} Verified directly against published circulars from <strong class="text-[#1C1917] dark:text-[#F5F2EB]">{meta.taxAuthority}</strong> for fiscal year 2026/2027.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
        {meta.features.map((feature: string) => (
          <div class="flex items-center gap-2 p-2.5 rounded-lg bg-[#F8F6F0] dark:bg-[#141210] border border-[#E7E2D7]/70 dark:border-[#2C2724]/70 text-xs text-[#1C1917] dark:text-[#F5F2EB] font-medium">
            <span class="text-[#006948] dark:text-[#85f8c4] font-bold">✓</span>
            <span>{feature}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
