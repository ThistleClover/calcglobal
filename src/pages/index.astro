---
// src/pages/index.astro - Creamy Executive Editorial with Smart Geo-Calculator & Interactive World Map
import Layout from '../layouts/Layout.astro';
import SmartLandingWorkbench from '../components/SmartLandingWorkbench';
import WorldMapDirectory from '../components/WorldMapDirectory';
import fs from 'fs';
import path from 'path';
import { ACTIVE_COUNTRIES, COUNTRY_METADATA } from '../config';

const dbDir = path.join(process.cwd(), 'database', 'countries');
const files = fs.readdirSync(dbDir).filter(f => f.endsWith('.json'));

let totalCalculators = 0;

const authorityMap: Record<string, string> = {
  us: 'IRS & State Treasury',
  uk: 'HMRC & PAYE',
  fr: 'URSSAF & DGFiP',
  de: 'BMF & Finanzamt',
  ca: 'CRA & Revenu Québec',
  au: 'ATO & Superannuation',
  es: 'AEAT & Seguridad Social',
  it: 'Agenzia delle Entrate & INPS',
  in: 'Income Tax Dept & CBDT',
  jp: 'NTA (国税庁)',
  br: 'Receita Federal & INSS',
  mx: 'SAT & IMSS',
  ae: 'Federal Tax Authority (FTA)',
  sg: 'IRAS & CPF Board',
  ch: 'ESTV & Cantons',
};

const continentMap: Record<string, 'North America' | 'Europe' | 'Asia-Pacific' | 'Latin America' | 'Middle East'> = {
  us: 'North America',
  ca: 'North America',
  mx: 'North America',
  uk: 'Europe',
  fr: 'Europe',
  de: 'Europe',
  ch: 'Europe',
  es: 'Europe',
  it: 'Europe',
  au: 'Asia-Pacific',
  sg: 'Asia-Pacific',
  jp: 'Asia-Pacific',
  in: 'Asia-Pacific',
  br: 'Latin America',
  ae: 'Middle East',
};

const mapCoordinates: Record<string, { cx: number; cy: number }> = {
  us: { cx: 210, cy: 175 },
  ca: { cx: 200, cy: 110 },
  mx: { cx: 190, cy: 225 },
  br: { cx: 330, cy: 310 },
  uk: { cx: 465, cy: 140 },
  fr: { cx: 475, cy: 165 },
  de: { cx: 500, cy: 150 },
  ch: { cx: 495, cy: 170 },
  es: { cx: 460, cy: 185 },
  it: { cx: 505, cy: 180 },
  ae: { cx: 620, cy: 220 },
  in: { cx: 685, cy: 225 },
  sg: { cx: 755, cy: 285 },
  jp: { cx: 825, cy: 180 },
  au: { cx: 810, cy: 360 },
};

const allCountries = files.map(file => {
  const raw = fs.readFileSync(path.join(dbDir, file), 'utf-8');
  const data = JSON.parse(raw);
  
  const calcCount = data.calculators?.length || 0;
  const slug = data.country_code.toLowerCase();
  const isActive = ACTIVE_COUNTRIES.includes(slug as any);

  if (isActive) {
    totalCalculators += calcCount;
  }
  
  const meta = COUNTRY_METADATA[slug];
  
  return {
    name: data.country,
    code: data.country_code,
    slug: slug,
    calculatorCount: calcCount,
    currencySymbol: meta?.currencySymbol || data.currency_symbol || '$',
    authority: authorityMap[slug] || 'National Tax Authority',
    topCalculators: data.calculators?.slice(0, 2).map((c: any) => ({
      id: c.id,
      title: c.title_en || c.title_native,
    })) || [],
    active: isActive,
  };
}).sort((a, b) => {
  if (a.active && !b.active) return -1;
  if (!a.active && b.active) return 1;
  return a.name.localeCompare(b.name);
});

const activeCountries = allCountries.filter(c => c.active);

// Build rich workbench dataset for all 15 countries
const countriesWorkbenchData = activeCountries.map(c => {
  const fileContent = fs.readFileSync(path.join(dbDir, `${c.slug}.json`), 'utf-8');
  const data = JSON.parse(fileContent);
  const meta = COUNTRY_METADATA[c.slug];
  
  return {
    code: c.slug,
    name: c.name,
    flagCode: c.slug === 'uk' ? 'gb' : c.slug,
    currencySymbol: meta?.currencySymbol || c.currencySymbol,
    locale: meta?.locale || data.locale || 'en-US',
    authority: c.authority,
    calculators: (data.calculators || []).map((calc: any) => ({
      id: calc.id,
      title: calc.title_native || calc.title_en,
      description: calc.description_native || '',
      category: calc.category || 'tax',
      inputs: calc.inputs || [],
      formula_explanation: calc.formula_explanation || 'Verified 2026 statutory rates and brackets.',
      affiliate_targets: calc.affiliate_targets || [],
    })),
  };
});

// Build world map dataset
const worldMapCountriesData = activeCountries.map(c => ({
  code: c.slug,
  name: c.name,
  flagCode: c.slug === 'uk' ? 'gb' : c.slug,
  continent: continentMap[c.slug] || 'Europe',
  authority: c.authority,
  calculatorCount: c.calculatorCount,
  currencySymbol: c.currencySymbol,
  topCalculators: c.topCalculators,
  cx: mapCoordinates[c.slug]?.cx || 450,
  cy: mapCoordinates[c.slug]?.cy || 200,
}));

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "CalcGlobal",
  "url": "https://calcglobal.org",
  "logo": "https://calcglobal.org/favicon.svg",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": "https://calcglobal.org/contact",
    "availableLanguage": ["English", "French", "German", "Spanish", "Italian", "Portuguese", "Japanese", "Hindi", "Arabic"]
  },
  "description": "Professional tax and financial calculators for 15 countries worldwide. Verified against 2026 official tax authority rates.",
  "areaServed": ["US", "GB", "FR", "DE", "AU", "CA", "ES", "IT", "IN", "JP", "BR", "MX", "AE", "SG", "CH"]
};

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<Layout 
  title="CalcGlobal | Statutory Tax & Payroll Infrastructure" 
  description="Precision tax, payroll, and statutory calculation engines across 15 countries. Verified for the 2026/27 tax year with 100% client-side calculation privacy."
  keywords="tax calculator, payroll calculator, statutory tax brackets, gross to net, IRS, HMRC, URSSAF, ATO, 2026"
  structuredData={orgSchema}
>
  <!-- Creamy Editorial Hero Section -->
  <section class="relative pt-8 sm:pt-10 pb-12 px-4 sm:px-6 max-w-6xl mx-auto space-y-12">
    
    <!-- Hero Headline & Intro -->
    <div class="text-center max-w-3xl mx-auto animate-fade-in">
      
      <!-- Headline -->
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-[#1C1917] dark:text-[#F5F2EB] leading-[1.15] mb-3">
        Statutory Precision for <br class="hidden sm:inline" />
        <span class="text-[#78716C] dark:text-[#A8A29E] font-medium">Cross-Border Income.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-xs sm:text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed max-w-2xl mx-auto">
        Hyper-accurate tax, payroll, and statutory calculation engines audited by certified CPAs. 100% browser-side math.
      </p>

      <!-- Tagline -->
      <div class="mt-4 pt-3 border-t border-[#E7E2D7] dark:border-[#2A2622] text-[11px] text-[#78716C] dark:text-[#A8A29E] flex items-center justify-center gap-2">
        <i class="ph ph-shield-check text-[#006948] dark:text-[#6EE7B7] text-[15px]"></i>
        <span>Tax engines verified against 2026/27 statutory rates.</span>
      </div>
    </div>

    <!-- Smart Auto-Detecting Geo Workbench & Official Partners Strip -->
    <div class="animate-scale-in">
      <div class="max-w-4xl mx-auto">
        <SmartLandingWorkbench
          client:load
          countries={countriesWorkbenchData}
          defaultCountryCode="us"
        />
      </div>
    </div>

    <!-- Interactive World Map & Categorized Jurisdictions Section -->
    <div class="pt-6 border-t border-[#E7E2D7] dark:border-[#2A2622]">
      <WorldMapDirectory
        client:load
        countries={worldMapCountriesData}
        base={base}
      />
    </div>

  </section>
</Layout>
