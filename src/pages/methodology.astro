---
// src/pages/methodology.astro - Editorial & Calculation Methodology (E-E-A-T)
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Tax Calculation Methodology & Editorial Standards",
  "url": "https://calcglobal.org/methodology/",
  "description": "Comprehensive explanation of how CalcGlobal models, verifies, and updates localized tax calculation formulas across official tax authorities with 100% client-side data privacy.",
  "publisher": {
    "@type": "Organization",
    "name": "CalcGlobal Tax Advisory Team",
    "url": "https://calcglobal.org"
  },
  "mainEntity": {
    "@type": "TechArticle",
    "headline": "CalcGlobal Statutory Tax Calculation Audit & Math Specification",
    "inLanguage": "en-US",
    "author": {
      "@type": "Organization",
      "name": "CalcGlobal Financial Engineering & CPA Review Panel"
    }
  }
};
---

<Layout
  title="Calculation Methodology & Editorial Standards | CalcGlobal"
  description="Learn how CalcGlobal algorithms are audited by Certified Public Accountants (CPAs) and cross-referenced with primary tax authority sources (IRS, HMRC, URSSAF, DGFiP, BMF, ATO)."
  keywords="tax calculation methodology, IRS tax brackets 2026, HMRC calculation formulas, URSSAF cotisations, CPA verified tax tools, client-side privacy"
  structuredData={schemaData}
>
  <!-- Hero Section -->
  <div class="pt-14 pb-20 px-4 bg-[#F8F6F0] dark:bg-[#0F0E0C] border-b border-[#E7E2D7] dark:border-[#2A2622]">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-[#78716C] dark:text-[#A8A29E] text-sm mb-6 font-medium">
        <a href={`${base}/`} class="hover:text-[#1C1917] dark:hover:text-[#F5F2EB] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#1C1917] dark:text-[#F5F2EB] font-semibold">Methodology & Audit Standards</span>
      </nav>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="px-3 py-1 bg-[#F0EEE8] dark:bg-[#252220] text-[#1C1917] dark:text-[#F5F2EB] text-xs font-bold rounded-lg border border-[#E7E2D7] dark:border-[#2A2622] flex items-center gap-1.5">
          <i class="ph ph-calendar-check text-[#006948] dark:text-[#6EE7B7]"></i>
          Audited for 2026/2027
        </span>
        <span class="px-3 py-1 bg-[#F0EEE8] dark:bg-[#252220] text-[#1C1917] dark:text-[#F5F2EB] text-xs font-bold rounded-lg border border-[#E7E2D7] dark:border-[#2A2622] flex items-center gap-1.5">
          <i class="ph ph-shield-check text-[#006948] dark:text-[#6EE7B7]"></i>
          CPA Reviewed
        </span>
        <span class="px-3 py-1 bg-[#F0EEE8] dark:bg-[#252220] text-[#1C1917] dark:text-[#F5F2EB] text-xs font-bold rounded-lg border border-[#E7E2D7] dark:border-[#2A2622] flex items-center gap-1.5">
          <i class="ph ph-lock text-[#006948] dark:text-[#6EE7B7]"></i>
          Client-Side Computation
        </span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB] tracking-tight leading-tight mb-6">
        Calculation Methodology & Editorial Standards
      </h1>
      
      <p class="text-[#78716C] dark:text-[#A8A29E] text-base md:text-lg leading-relaxed max-w-3xl font-medium">
        Precision, transparency, and statutory accuracy. Discover how CalcGlobal models complex global tax structures, verifies formulas, and ensures your data remains private.
      </p>
    </div>
  </div>

  <!-- Main Content Body -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    
    <!-- Trust Summary Callout Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16 -mt-20 relative z-20">
      <div class="bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-6 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[#F0EEE8] dark:bg-[#252220] text-[#006948] dark:text-[#6EE7B7] flex items-center justify-center text-xl font-bold mb-4 border border-[#E7E2D7] dark:border-[#2A2622]">
          <i class="ph ph-buildings"></i>
        </div>
        <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg mb-2">Primary Sourced</h3>
        <p class="text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
          Every bracket, cap, and rate is derived directly from official government tax authority releases.
        </p>
      </div>

      <div class="bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-6 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[#F0EEE8] dark:bg-[#252220] text-[#006948] dark:text-[#6EE7B7] flex items-center justify-center text-xl font-bold mb-4 border border-[#E7E2D7] dark:border-[#2A2622]">
          <i class="ph ph-briefcase"></i>
        </div>
        <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg mb-2">CPA Audited</h3>
        <p class="text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
          Calculations and edge cases are reviewed by Certified Public Accountants and Tax Advisers.
        </p>
      </div>

      <div class="bg-[#FDFCF9] dark:bg-[#1A1816] rounded-2xl p-6 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-[#F0EEE8] dark:bg-[#252220] text-[#006948] dark:text-[#6EE7B7] flex items-center justify-center text-xl font-bold mb-4 border border-[#E7E2D7] dark:border-[#2A2622]">
          <i class="ph ph-lock"></i>
        </div>
        <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg mb-2">100% Private</h3>
        <p class="text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
          All calculations run locally in your browser. No income data is ever saved or sent to a server.
        </p>
      </div>
    </div>

    <!-- Section 1: Algorithmic Architecture & Precision Math -->
    <section class="mb-16 bg-[#FDFCF9] dark:bg-[#1A1816] rounded-3xl p-8 md:p-10 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-[#006948] dark:bg-[#6EE7B7] text-[#FDFCF9] dark:text-[#1A1816] flex items-center justify-center font-bold text-sm">
          01
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB]">
          Architecture & Math Engine
        </h2>
      </div>

      <div class="max-w-none text-[#78716C] dark:text-[#A8A29E] leading-relaxed space-y-4">
        <p>
          Tax law is inherently piecewise and marginal. CalcGlobal models statutory tax algorithms using structured discrete interval evaluation rather than simplified effective averages.
        </p>
        
        <div class="bg-[#F0EEE8] dark:bg-[#252220] p-6 rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622] my-6">
          <h4 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-base mb-3 flex items-center gap-2">
            <i class="ph ph-calculator text-[#006948] dark:text-[#6EE7B7] text-xl"></i>
            Key Mathematical Principles
          </h4>
          <ul class="space-y-3 text-sm text-[#78716C] dark:text-[#A8A29E]">
            <li class="flex items-start gap-2">
              <span class="text-[#006948] dark:text-[#6EE7B7] font-bold mt-0.5">•</span>
              <span><strong class="text-[#1C1917] dark:text-[#F5F2EB]">Marginal Progressive Brackets:</strong> Tax rates are applied strictly to the portion of income within each defined bracket, avoiding cliff-effects.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#006948] dark:text-[#6EE7B7] font-bold mt-0.5">•</span>
              <span><strong class="text-[#1C1917] dark:text-[#F5F2EB]">Wage Base & Contribution Caps:</strong> Statutory limits (such as the US Social Security cap or the French PASS) are hard-capped.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#006948] dark:text-[#6EE7B7] font-bold mt-0.5">•</span>
              <span><strong class="text-[#1C1917] dark:text-[#F5F2EB]">Phase-Out Schedules:</strong> Tapering mechanisms are dynamically computed step-by-step.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#006948] dark:text-[#6EE7B7] font-bold mt-0.5">•</span>
              <span><strong class="text-[#1C1917] dark:text-[#F5F2EB]">Floating-Point Precision:</strong> Processed to sub-cent precision and rounded according to local statutory rules.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 2: Official Government Data Sources -->
    <section id="data-sources" class="mb-16 bg-[#FDFCF9] dark:bg-[#1A1816] rounded-3xl p-8 md:p-10 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm scroll-mt-24">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-[#006948] dark:bg-[#6EE7B7] text-[#FDFCF9] dark:text-[#1A1816] flex items-center justify-center font-bold text-sm">
          02
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB]">
          Government Data Sources
        </h2>
      </div>

      <p class="text-[#78716C] dark:text-[#A8A29E] mb-8 leading-relaxed">
        We do not rely on third-party estimates. All formulas and constants are audited against public government documentation:
      </p>

      <div class="space-y-6">
        <!-- USA -->
        <div class="bg-[#F0EEE8] dark:bg-[#252220] p-6 rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622]">
          <div class="flex items-center gap-3 mb-3">
            <i class="ph ph-globe text-2xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <div>
              <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg">United States</h3>
              <span class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7]">Internal Revenue Service (IRS)</span>
            </div>
          </div>
          <p class="text-sm text-[#78716C] dark:text-[#A8A29E] mb-3">
            Updated for 2026 based on IRS Revenue Procedures (Rev. Proc. 2024-40) and official adjustments.
          </p>
          <ul class="text-sm text-[#78716C] dark:text-[#A8A29E] space-y-1.5 list-disc pl-5">
            <li>Federal Income Tax Brackets (10% to 37%)</li>
            <li>Standard Deductions & FICA Self-Employment Tax</li>
            <li>State Tax Schedules</li>
          </ul>
        </div>

        <!-- UK -->
        <div class="bg-[#F0EEE8] dark:bg-[#252220] p-6 rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622]">
          <div class="flex items-center gap-3 mb-3">
            <i class="ph ph-globe text-2xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <div>
              <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg">United Kingdom</h3>
              <span class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7]">HM Revenue & Customs (HMRC)</span>
            </div>
          </div>
          <p class="text-sm text-[#78716C] dark:text-[#A8A29E] mb-3">
            Calibrated for the 2026/2027 fiscal year in accordance with HMRC budget guidance.
          </p>
          <ul class="text-sm text-[#78716C] dark:text-[#A8A29E] space-y-1.5 list-disc pl-5">
            <li>PAYE Income Tax Bands</li>
            <li>National Insurance Contributions (NIC)</li>
            <li>Dividend Tax Allowances</li>
          </ul>
        </div>

        <!-- France -->
        <div class="bg-[#F0EEE8] dark:bg-[#252220] p-6 rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622]">
          <div class="flex items-center gap-3 mb-3">
            <i class="ph ph-globe text-2xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <div>
              <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg">France</h3>
              <span class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7]">URSSAF & DGFiP</span>
            </div>
          </div>
          <p class="text-sm text-[#78716C] dark:text-[#A8A29E] mb-3">
            Integrated with the 2026 PASS and Code Général des Impôts (CGI).
          </p>
          <ul class="text-sm text-[#78716C] dark:text-[#A8A29E] space-y-1.5 list-disc pl-5">
            <li>Cotisations sociales micro-entreprise & régimes généraux</li>
            <li>Barème progressif de l'Impôt sur le Revenu</li>
            <li>Calculateur de Salaire Brut / Net</li>
          </ul>
        </div>

        <!-- Germany -->
        <div class="bg-[#F0EEE8] dark:bg-[#252220] p-6 rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622]">
          <div class="flex items-center gap-3 mb-3">
            <i class="ph ph-globe text-2xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <div>
              <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg">Germany</h3>
              <span class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7]">Finanzamt & BMF</span>
            </div>
          </div>
          <p class="text-sm text-[#78716C] dark:text-[#A8A29E] mb-3">
            Engineered according to the official 2026 BMF EStG Programmablaufpläne.
          </p>
          <ul class="text-sm text-[#78716C] dark:text-[#A8A29E] space-y-1.5 list-disc pl-5">
            <li>Brutto-Netto-Rechner</li>
            <li>Grundfreibetrag und Tarifzonen</li>
            <li>Solidaritätszuschlag & Kirchensteuer</li>
          </ul>
        </div>

        <!-- Australia -->
        <div class="bg-[#F0EEE8] dark:bg-[#252220] p-6 rounded-2xl border border-[#E7E2D7] dark:border-[#2A2622]">
          <div class="flex items-center gap-3 mb-3">
            <i class="ph ph-globe text-2xl text-[#006948] dark:text-[#6EE7B7]"></i>
            <div>
              <h3 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-lg">Australia</h3>
              <span class="text-xs font-semibold text-[#006948] dark:text-[#6EE7B7]">Australian Taxation Office (ATO)</span>
            </div>
          </div>
          <p class="text-sm text-[#78716C] dark:text-[#A8A29E] mb-3">
            Calibrated for the 2026/2027 Australian financial year.
          </p>
          <ul class="text-sm text-[#78716C] dark:text-[#A8A29E] space-y-1.5 list-disc pl-5">
            <li>ATO Individual Income Tax Brackets & Medicare Levy</li>
            <li>HECS/HELP Repayment Thresholds</li>
            <li>Superannuation Guarantee</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 3: Expert Review Team & Audit Process -->
    <section id="expert-reviewers" class="mb-16 bg-[#FDFCF9] dark:bg-[#1A1816] rounded-3xl p-8 md:p-10 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm scroll-mt-24">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-[#006948] dark:bg-[#6EE7B7] text-[#FDFCF9] dark:text-[#1A1816] flex items-center justify-center font-bold text-sm">
          03
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB]">
          Expert Advisory Panel & Audit Workflow
        </h2>
      </div>

      <p class="text-[#78716C] dark:text-[#A8A29E] mb-6 leading-relaxed">
        Our tools are maintained by a dedicated multidisciplinary team consisting of tax software engineers, financial analysts, and Certified Public Accountants.
      </p>

      <div class="bg-[#F0EEE8] dark:bg-[#252220] rounded-2xl p-6 md:p-8 mb-8 border border-[#E7E2D7] dark:border-[#2A2622]">
        <h3 class="text-xl font-bold mb-4 flex items-center gap-2 text-[#1C1917] dark:text-[#F5F2EB]">
          <i class="ph ph-check-circle text-[#006948] dark:text-[#6EE7B7]"></i> 4-Step Verification Process
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="bg-[#FDFCF9] dark:bg-[#1A1816] p-4 rounded-xl border border-[#E7E2D7] dark:border-[#2A2622]">
            <span class="text-[#1C1917] dark:text-[#F5F2EB] font-bold block mb-1">Step 1: Monitoring</span>
            <p class="text-[#78716C] dark:text-[#A8A29E]">Continuous tracking of IRS, HMRC, URSSAF, BMF, and ATO legislative releases.</p>
          </div>
          <div class="bg-[#FDFCF9] dark:bg-[#1A1816] p-4 rounded-xl border border-[#E7E2D7] dark:border-[#2A2622]">
            <span class="text-[#1C1917] dark:text-[#F5F2EB] font-bold block mb-1">Step 2: Recalibration</span>
            <p class="text-[#78716C] dark:text-[#A8A29E]">Algorithmic implementation of new brackets, thresholds, and caps.</p>
          </div>
          <div class="bg-[#FDFCF9] dark:bg-[#1A1816] p-4 rounded-xl border border-[#E7E2D7] dark:border-[#2A2622]">
            <span class="text-[#1C1917] dark:text-[#F5F2EB] font-bold block mb-1">Step 3: CPA Unit Testing</span>
            <p class="text-[#78716C] dark:text-[#A8A29E]">Cross-testing engine output against official government sample returns.</p>
          </div>
          <div class="bg-[#FDFCF9] dark:bg-[#1A1816] p-4 rounded-xl border border-[#E7E2D7] dark:border-[#2A2622]">
            <span class="text-[#1C1917] dark:text-[#F5F2EB] font-bold block mb-1">Step 4: Audit Sign-Off</span>
            <p class="text-[#78716C] dark:text-[#A8A29E]">Final certification and deployment to public web apps.</p>
          </div>
        </div>
      </div>

      <div class="border-t border-[#E7E2D7] dark:border-[#2A2622] pt-6">
        <h4 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-base mb-2">Audit Frequency</h4>
        <p class="text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
          Standard baseline audits occur quarterly. In cases of sudden legislative modifications, our team deploys engine updates within 48 hours of official publication.
        </p>
      </div>
    </section>

    <!-- Section 4: 100% Client-Side Privacy Guarantee -->
    <section id="privacy" class="mb-16 bg-[#FDFCF9] dark:bg-[#1A1816] rounded-3xl p-8 md:p-10 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm scroll-mt-24">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-[#006948] dark:bg-[#6EE7B7] text-[#FDFCF9] dark:text-[#1A1816] flex items-center justify-center font-bold text-sm">
          04
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#1C1917] dark:text-[#F5F2EB]">
          100% Client-Side Privacy Guarantee
        </h2>
      </div>

      <div class="bg-[#F0EEE8] dark:bg-[#252220] border border-[#E7E2D7] dark:border-[#2A2622] rounded-2xl p-6 mb-6">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full bg-[#FDFCF9] dark:bg-[#1A1816] text-[#006948] dark:text-[#6EE7B7] flex items-center justify-center shrink-0 font-bold text-base mt-0.5 border border-[#E7E2D7] dark:border-[#2A2622]">
            <i class="ph ph-lock"></i>
          </div>
          <div>
            <h4 class="font-bold text-[#1C1917] dark:text-[#F5F2EB] text-base mb-1">Inputs Never Leave Your Device</h4>
            <p class="text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed">
              When you enter salary or expense amounts, all calculations occur strictly inside your device's web browser memory.
            </p>
          </div>
        </div>
      </div>

      <ul class="space-y-3 text-sm text-[#78716C] dark:text-[#A8A29E] list-disc pl-5">
        <li><strong class="text-[#1C1917] dark:text-[#F5F2EB]">Zero Data Transmission:</strong> Inputs are not sent to any server.</li>
        <li><strong class="text-[#1C1917] dark:text-[#F5F2EB]">Zero Financial Databases:</strong> We do not log or track user tax estimates.</li>
        <li><strong class="text-[#1C1917] dark:text-[#F5F2EB]">No Account Required:</strong> Accessible instantly without login barriers.</li>
      </ul>
    </section>

    <!-- Strategic AdSlot -->
    <AdSlot variant="leaderboard" pageIntent="low" className="my-10" />

    <!-- Section 5: Editorial Guidelines & Contact -->
    <section id="editorial-policy" class="bg-[#FDFCF9] dark:bg-[#1A1816] text-[#78716C] dark:text-[#A8A29E] rounded-3xl p-8 md:p-10 border border-[#E7E2D7] dark:border-[#2A2622] shadow-sm scroll-mt-24">
      <h2 class="text-2xl font-bold text-[#1C1917] dark:text-[#F5F2EB] mb-4">Editorial Policy & Corrections</h2>
      <p class="text-sm text-[#78716C] dark:text-[#A8A29E] leading-relaxed mb-6">
        Transparency is essential. If you notice any discrepancies in local terminology or thresholds, our editorial team investigates immediately.
      </p>
      
      <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-[#E7E2D7] dark:border-[#2A2622]">
        <div>
          <span class="text-xs text-[#78716C] dark:text-[#A8A29E] block mb-1">Have a question or feedback?</span>
          <span class="text-sm font-bold text-[#1C1917] dark:text-[#F5F2EB]">Contact the Advisory Team</span>
        </div>
        <a
          href={`${base}/contact/`}
          class="px-5 py-2.5 bg-[#006948] dark:bg-[#6EE7B7] hover:bg-[#005238] dark:hover:bg-[#5CD6A6] text-white dark:text-[#1C1917] text-sm font-semibold rounded-xl transition-colors shadow-sm flex items-center gap-2"
        >
          Submit Inquiry <i class="ph ph-arrow-right"></i>
        </a>
      </div>
    </section>

  </div>
</Layout>
