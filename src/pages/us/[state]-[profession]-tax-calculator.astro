const stateInfo = STATES_DATA[stateKey];
const professionInfo = PROFESSIONS_DATA[professionKey];

if (!stateInfo || !professionInfo) {
  throw new Error(`Invalid state (${stateKey}) or profession (${professionKey})`);
}

// Compute pre-calculated scenarios for the 4 revenue levels
const scenarioResults = professionInfo.sampleRevenues.map(rev => {
  const res = calculate({
    calculator_id: 'us-1099-self-employment-tax-calculator',
    net_1099_profit: rev,
    state: stateInfo.code,
    filing_status: 'single',
    other_w2_income: 0,
  });

  const seTaxLine = res.breakdown.find(b => b.label.includes('Self-Employment Tax'))?.value || 0;
  const fedIncomeTaxLine = res.breakdown.find(b => b.label.includes('Federal Income Tax'))?.value || 0;
  const stateTaxLine = res.breakdown.find(b => b.label.includes('State Income Tax'))?.value || 0;

  return {
    gross: rev,
    seTax: seTaxLine,
    fedIncomeTax: fedIncomeTaxLine,
    stateTax: stateTaxLine,
    totalTax: res.totalTax,
    netIncome: res.netIncome,
    effectiveRate: (res.effectiveRate * 100).toFixed(1),
    quarterlyPayment: res.quarterlyPayment || 0,
  };
});

