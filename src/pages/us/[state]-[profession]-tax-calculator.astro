export function getStaticPaths() {
  const states = ['ca', 'ny', 'tx', 'fl', 'il'];
  const professions = ['freelance-developer', 'consultant'];
  const paths: any[] = [];

  for (const state of states) {
    for (const profession of professions) {
      paths.push({
        params: { state, profession },
        props: { stateKey: state, professionKey: profession },
      });
    }
  }

  return paths;
}

const { stateKey, professionKey } = Astro.props;

