export function getStaticPaths() {
  const states = ['ca', 'ny', 'tx', 'fl', 'il', 'wa', 'nv', 'ma', 'pa', 'ga', 'oh', 'nc', 'mi', 'nj', 'va'];
  const professions = ['freelance-developer', 'consultant', 'real-estate-agent', 'creator'];
  const paths: any[] = [];

  for (const state of states) {
    for (const profession of professions) {
      paths.push({
        params: { state, profession },
        props: { stateKey: state, professionKey: profession },
      });
    }
  }

  return paths;
}

const { stateKey, professionKey } = Astro.props;

interface StateInfo {
  code: string;
  name: string;
  taxType: string;
  rateText: string;
  authority: string;
  authorityAbbr: string;
  details: string;
  cityTaxNote?: string;
  highlights: string[];
}

interface ProfessionInfo {
  slug: string;
  name: string;
  plural: string;
  category: string;
  overview: string;
  sampleRevenues: number[];
  deductions: { title: string; category: string; description: string; exampleItems: string[] }[];
}

