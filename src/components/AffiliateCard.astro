---
import {
  getAffiliateLogo,
  getAffiliateButtonText,
  getAffiliateContextualCopy,
interface Props {
  partner: {
    name: string;
    type?: string;
    description: string;
    url?: string;
    logo?: string;
    cta?: string;
    country?: string;
  };
  ctaText?: string;
  calculatorId?: string;
  country?: string;
  position?: string;
}

const { partner, ctaText, calculatorId, country, position = 'results_panel' } = Astro.props;

// Determine logo icon or emoji based on logo field or partner type
let logoIcon = partner.logo;
if (!logoIcon) {
  const type = (partner.type || '').toLowerCase();
  if (type.includes('bank') || type.includes('neo')) logoIcon = '🏦';
  else if (type.includes('soft') || type.includes('account')) logoIcon = '💻';
  else if (type.includes('insur')) logoIcon = '🛡️';
  else if (type.includes('leg') || type.includes('incorp')) logoIcon = '⚖️';
  else if (type.includes('pay') || type.includes('hr')) logoIcon = '💼';
  else if (type.includes('real') || type.includes('mortg')) logoIcon = '🏠';
  else logoIcon = '⚡';
}

// CTA text logic
const buttonText = partner.cta || ctaText || (partner.type === 'software' ? 'Try Free' : 'Get Started');
const targetUrl = partner.url || '#';

const effectiveCalcId = calculatorId || Astro.params.calculator || '';
const effectiveCountry = (country || Astro.params.country || partner.country || '').toUpperCase();
---

<div class="group relative bg-white rounded-xl border border-slate-200 p-6 shadow-sm hover:shadow-md hover:border-slate-300 hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between h-full">
  <div>
    <!-- Top Row: Logo & Sponsored Badge -->
    <div class="flex items-center justify-between mb-4">
      <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center text-xl shadow-inner group-hover:scale-105 transition-transform">
        {logoIcon}
      </div>
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-100/80 px-2 py-0.5 rounded border border-slate-200/60">
        Sponsored
      </span>
    </div>

    <!-- Partner Title -->
    <h3 class="text-base font-bold text-slate-900 group-hover:text-slate-800 mb-2 transition-colors">
      {partner.name}
    </h3>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
      {partner.description}
    </p>
  </div>

  <!-- CTA Button -->
  <a
    href={targetUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-affiliate-cta
    data-partner-name={partner.name}
    data-calculator-id={effectiveCalcId}
    data-country={effectiveCountry}
    data-cta-url={targetUrl}
    data-position={position}
    onclick={`
      (function(btn) {
        var payload = {
          event_name: 'affiliate_card_click',
          partner_name: btn.getAttribute('data-partner-name') || '',
          calculator_id: btn.getAttribute('data-calculator-id') || '',
          country: btn.getAttribute('data-country') || '',
          cta_url: btn.getAttribute('data-cta-url') || '',
          position: btn.getAttribute('data-position') || 'results_panel'
        };
        try {
          if (typeof window !== 'undefined') {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'affiliate_card_click', payload);
            }
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(Object.assign({ event: 'affiliate_card_click' }, payload));
          }
        } catch (e) {
          console.error('GA4 tracking error:', e);
        }
      })(this);
    `}
    class="inline-flex items-center justify-center w-full rounded-lg bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 transition-colors gap-1.5"
  >
    <span>{buttonText}</span>
    <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
  </a>
</div>
