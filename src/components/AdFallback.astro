---
// src/components/AdFallback.astro
// Native affiliate banners that bypass AdBlock using REAL monetization sources
---
<div class="w-full rounded-xl overflow-hidden border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow">
  <div id="affiliate-fallback-container" class="w-full h-full">
    <!-- Default state (Shopify) -->
    <a href="/go/shopify" target="_blank" rel="noopener noreferrer" class="block p-5 sm:p-6 flex flex-col sm:flex-row items-center gap-4 sm:gap-6 no-underline group">
      <div class="flex-shrink-0 w-14 h-14 sm:w-16 sm:h-16 bg-purple-50 rounded-xl flex items-center justify-center group-hover:scale-105 transition-transform">
        <svg class="w-7 h-7 sm:w-8 sm:h-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <div class="flex-grow text-center sm:text-left">
        <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1 group-hover:text-purple-600 transition-colors">Lancez votre E-Commerce</h4>
        <p class="text-xs sm:text-sm text-slate-500">Créez, gérez et développez votre boutique en ligne avec Shopify.</p>
      </div>
      <div class="flex-shrink-0 mt-2 sm:mt-0">
        <span class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-purple-600 rounded-lg group-hover:bg-purple-700 transition-colors">
          Essai Gratuit
        </span>
      </div>
    </a>
  </div>
</div>

<script is:inline>
  const offers = [
    {
      url: '/go/shopify',
      title: 'Lancez votre E-Commerce',
      desc: 'Créez, gérez et développez votre entreprise partout avec Shopify.',
      cta: 'Essai Gratuit',
      icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />',
      iconBg: 'bg-purple-50', iconText: 'text-purple-600', titleHover: 'group-hover:text-purple-600', btnBg: 'bg-purple-600', btnHover: 'group-hover:bg-purple-700'
    },
    {
      url: '/go/sage',
      title: 'Optimisez votre Comptabilité',
      desc: 'Gagnez du temps avec le logiciel de gestion et facturation leader pour entrepreneurs.',
      cta: 'Découvrir Sage',
      icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />',
      iconBg: 'bg-emerald-50', iconText: 'text-emerald-600', titleHover: 'group-hover:text-emerald-600', btnBg: 'bg-emerald-600', btnHover: 'group-hover:bg-emerald-700'
    }
  ];

  try {
    const offer = offers[Math.floor(Math.random() * offers.length)];
    const container = document.getElementById('affiliate-fallback-container');
    if (container) {
      container.innerHTML = `
        <a href="${offer.url}" target="_blank" rel="noopener noreferrer" class="block p-5 sm:p-6 flex flex-col sm:flex-row items-center gap-4 sm:gap-6 no-underline group">
          <div class="flex-shrink-0 w-14 h-14 sm:w-16 sm:h-16 ${offer.iconBg} rounded-xl flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 ${offer.iconText}" fill="none" viewBox="0 0 24 24" stroke="currentColor">${offer.icon}</svg>
          </div>
          <div class="flex-grow text-center sm:text-left">
            <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1 ${offer.titleHover} transition-colors">${offer.title}</h4>
            <p class="text-xs sm:text-sm text-slate-500">${offer.desc}</p>
          </div>
          <div class="flex-shrink-0 mt-2 sm:mt-0">
            <span class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white ${offer.btnBg} rounded-lg ${offer.btnHover} transition-colors">
              ${offer.cta}
            </span>
          </div>
        </a>
      `;
    }
  } catch(e) {}
</script>
