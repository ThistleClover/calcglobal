---
import AdFallback from './AdFallback.astro';

interface Props {
  variant?: 'leaderboard' | 'rectangle' | 'in-article';
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
  pageIntent?: 'high' | 'low';
}

const { variant: propVariant, format, slotId, className = 'my-8', pageIntent = 'low' } = Astro.props;

// Publisher ID
const PUBLISHER_ID = 'ca-pub-6264279528687703';

// Map legacy format to variant if variant is omitted
const variant = propVariant || (format === 'horizontal' ? 'leaderboard' : format === 'rectangle' ? 'rectangle' : 'in-article');

let adFormat = 'auto';
let adLayout: string | undefined = undefined;
let minHeightClass = 'min-h-[90px]';

if (variant === 'leaderboard') {
  adFormat = 'horizontal';
  minHeightClass = 'min-h-[90px]';
} else if (variant === 'rectangle') {
  adFormat = 'rectangle';
  minHeightClass = 'min-h-[250px]';
} else if (variant === 'in-article') {
  adFormat = 'fluid';
  adLayout = 'in-article';
  minHeightClass = 'min-h-[120px]';
}

const uniqueId = Math.random().toString(36).substring(7);
---

{pageIntent !== 'high' && (
  <div id={`ad-container-${uniqueId}`} class={`ad-container w-full ${className}`}>
    <div id={`fallback-${uniqueId}`} class="hidden w-full">
      <AdFallback />
    </div>
    <div id={`adsense-${uniqueId}`} class={`adsense-wrapper flex justify-center w-full ${minHeightClass}`}>
      <ins class="adsbygoogle w-full"
           style="display:block; text-align:center;"
           data-ad-client={PUBLISHER_ID}
           data-ad-slot={slotId}
           data-ad-format={adFormat}
           {...(adLayout ? { 'data-ad-layout': adLayout } : {})}
           data-full-width-responsive="true"></ins>
      <script is:inline define:vars={{ uid: uniqueId }}>
        (function() {
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
          
          // Anti-Adblock / Fallback trigger
          setTimeout(() => {
            const ins = document.querySelector(`#adsense-${uid} ins`);
            // If the ad slot has 0 height or is hidden, AdBlock is likely active
            if (!ins || ins.clientHeight === 0 || window.getComputedStyle(ins).display === 'none') {
              const adsenseWrapper = document.getElementById(`adsense-${uid}`);
              const fallbackWrapper = document.getElementById(`fallback-${uid}`);
              if (adsenseWrapper && fallbackWrapper) {
                adsenseWrapper.style.display = 'none';
                fallbackWrapper.classList.remove('hidden');
              }
            }
          }, 1500); // 1.5s delay to let Google render the iframe
        })();
      </script>
    </div>
  </div>
)}
