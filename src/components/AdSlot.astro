---
interface Props {
  variant?: 'leaderboard' | 'rectangle' | 'in-article';
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
  pageIntent?: 'high' | 'low';
}

const { variant: propVariant, format, slotId, className = 'my-8', pageIntent = 'low' } = Astro.props;

// Publisher ID
const PUBLISHER_ID = 'ca-pub-6264279528687703';

// Map legacy format to variant if variant is omitted
const variant = propVariant || (format === 'horizontal' ? 'leaderboard' : format === 'rectangle' ? 'rectangle' : 'in-article');

let adFormat = 'auto';
let adLayout: string | undefined = undefined;
let minHeightClass = 'min-h-[90px]';

if (variant === 'leaderboard') {
  adFormat = 'horizontal';
  minHeightClass = 'min-h-[90px]';
} else if (variant === 'rectangle') {
  adFormat = 'rectangle';
  minHeightClass = 'min-h-[250px]';
} else if (variant === 'in-article') {
  adFormat = 'fluid';
  adLayout = 'in-article';
  minHeightClass = 'min-h-[120px]';
}
---

{pageIntent !== 'high' && (
  <div class={`adsense-wrapper flex justify-center w-full ${minHeightClass} ${className}`}>
    <ins class="adsbygoogle w-full"
         style="display:block; text-align:center;"
         data-ad-client={PUBLISHER_ID}
         data-ad-slot={slotId}
         data-ad-format={adFormat}
         {...(adLayout ? { 'data-ad-layout': adLayout } : {})}
         data-full-width-responsive="true"></ins>
    <script is:inline>
      // Initialize the ad slot safely
      (function() {
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {
          console.warn('AdSense blocked or failed to load');
        }
      })();
    </script>
  </div>
)}

<style>
  /* Fallback styling if ads are blocked so we don't leave an ugly blank space */
  .adsense-wrapper {
    overflow: hidden;
  }
  .adsense-wrapper:empty,
  .adsense-wrapper ins:empty {
    display: none !important;
    min-height: 0 !important;
    height: 0 !important;
    margin: 0 !important;
  }
</style>
